---
/**
 * Country and language: a small popover that opens under the flag chip.
 * One tap changes the language; one tap sets the country. No Save button,
 * no full-screen sheet. The chosen flag flies; the others rest with a soft
 * curl and lift when hovered. Country names come from Intl.DisplayNames, so
 * no list needs translating. Wired up in scripts/locale.ts.
 */
import { COUNTRIES } from '../data/countries';
import { LOCALES, LOCALE_NAMES, LOCALE_TAGS, type Locale } from '../i18n/config';
import { getDict } from '../i18n';
import FlagWave from './FlagWave.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const names = new Intl.DisplayNames([LOCALE_TAGS[locale]], { type: 'region' });
const countries = COUNTRIES.map(c => ({ ...c, name: names.of(c.code) ?? c.code }))
  .sort((a, b) => a.name.localeCompare(b.name, LOCALE_TAGS[locale]));
const LANG_FLAG: Record<Locale, string> = { en: 'gb', de: 'de', fr: 'fr', es: 'es', it: 'it' };
const tick = '<svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.5l2.2 2.2L9.5 3.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<div id="locale-pop" class="locale-pop" role="dialog" aria-labelledby="locale-pop-title" hidden>
  <div class="flex items-center justify-between gap-2 pl-4 pr-2 pt-2.5">
    <h2 id="locale-pop-title" class="font-sans text-[0.9rem] font-extrabold tracking-normal text-ink">{t.locale.languageLabel}</h2>
    <button type="button" data-locale-close class="grid h-8 w-8 place-items-center rounded-full text-ink-muted transition-colors hover:bg-bg-muted hover:text-ink" aria-label={t.locale.close}>
      <svg width="12" height="12" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
    </button>
  </div>

  <div class="grid grid-cols-5 gap-1 px-2.5 pt-1.5" role="radiogroup" aria-label={t.locale.languageLabel}>
    {LOCALES.map(l => (
      <button type="button" role="radio" aria-checked={l === locale ? 'true' : 'false'} data-lang={l} lang={l} title={LOCALE_NAMES[l]} aria-label={LOCALE_NAMES[l]} class="lang-opt fly-host">
        <FlagWave code={LANG_FLAG[l]} size="md" />
        <span class="text-[0.72rem] font-extrabold uppercase">{l}</span>
      </button>
    ))}
  </div>

  <div class="mx-4 mt-3 h-px bg-line"></div>

  <p class="px-4 pt-2.5 text-[0.9rem] font-extrabold text-ink">{t.locale.countryLabel}</p>
  <label class="relative mx-2.5 mt-1.5 block">
    <span class="sr-only">{t.locale.searchCountry}</span>
    <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    <input type="search" data-country-search placeholder={t.locale.searchCountry} autocomplete="off" class="h-10 w-full rounded-pill bg-bg-muted pl-8 pr-3 text-[16px] text-ink outline-none placeholder:text-[0.85rem] placeholder:text-ink-muted focus:bg-bg-elevated focus:shadow-[0_0_0_1.5px_var(--c-ink)] sm:text-[0.9rem]" />
  </label>
  <ul class="country-list mt-1.5 max-h-[11rem] overflow-y-auto overscroll-contain px-1.5 pb-1.5" role="listbox" aria-label={t.locale.countryLabel} data-country-list>
    {countries.map(c => (
      <li>
        <button type="button" role="option" aria-selected="false" data-country={c.code} data-name={c.name.toLowerCase()} class="country-opt fly-host">
          <FlagWave code={c.code} size="sm" />
          <span class="min-w-0 flex-1 truncate text-left">{c.name}</span>
          <span class="opt-tick" set:html={tick} />
        </button>
      </li>
    ))}
    <li>
      <button type="button" role="option" aria-selected="false" data-country="" data-name="" class="country-opt" data-other>
        <span class="grid h-[14px] w-[21px] shrink-0 place-items-center rounded-[3px] bg-bg-muted"><svg width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-8.5-6h17M3.5 9h17"/></svg></span>
        <span class="min-w-0 flex-1 truncate text-left">{t.locale.otherCountry}</span>
        <span class="opt-tick" set:html={tick} />
      </button>
    </li>
  </ul>
  <p class="px-4 pb-2 text-[0.8rem] text-ink-muted" data-country-empty hidden>{t.locale.noMatch}</p>

  <div class="space-y-0.5 border-t border-line bg-bg-muted/60 px-4 py-2.5 text-[0.78rem] leading-snug text-ink-soft" aria-live="polite">
    <p class="flex items-center gap-2"><FlagWave size="xs" data-preview-flag hidden /><span data-preview="your-time" data-template={t.local.yourTime}></span></p>
    <p class="flex items-center gap-2"><FlagWave code="in" size="xs" fly /><span data-preview="india-time" data-template={t.local.nowInIndia}></span></p>
  </div>
</div>

<style>
  .locale-pop {
    position: fixed;
    z-index: 60;
    top: calc(var(--header-h) + var(--notice-h, 0px) + 6px);
    right: var(--pop-right, 12px);
    width: min(20rem, calc(100vw - 24px));
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: 20px;
    background: var(--c-bg-elevated);
    box-shadow: 0 18px 50px -18px rgb(20 22 26 / 0.35), 0 2px 8px rgb(20 22 26 / 0.06);
    transform-origin: calc(100% - 28px) 0;
  }
  .locale-pop.is-open { animation: pop 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
  .locale-pop.is-closing { animation: pop-out 0.16s ease-in forwards; }
  @keyframes pop { from { opacity: 0; transform: translateY(-6px) scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes pop-out { to { opacity: 0; transform: translateY(-4px) scale(0.98); } }

  .lang-opt {
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    padding: 0.55rem 0 0.4rem; border-radius: 12px; color: var(--c-ink-soft);
    transition: background-color 0.2s, color 0.2s, transform 0.2s;
  }
  .lang-opt:hover { background: var(--c-bg-muted); color: var(--c-ink); }
  .lang-opt:active { transform: scale(0.94); }
  .lang-opt[aria-checked="true"] { background: var(--c-brand-soft); color: var(--c-ink); box-shadow: inset 0 0 0 1.5px var(--c-brand); }

  .country-opt {
    display: flex; width: 100%; align-items: center; gap: 0.6rem;
    min-height: 2.5rem; padding: 0 0.6rem; border-radius: 10px;
    font-size: 0.88rem; font-weight: 600; color: var(--c-ink);
    transition: background-color 0.15s;
  }
  .country-opt:hover, .country-opt:focus-visible { background: var(--c-bg-muted); }
  .country-opt[aria-selected="true"] { background: var(--c-brand-soft); }
  .opt-tick { display: grid; place-items: center; color: var(--c-brand-deep); opacity: 0; transition: opacity 0.2s; }
  .country-opt[aria-selected="true"] .opt-tick { opacity: 1; }
  .country-list { scrollbar-width: thin; }
  @media (prefers-reduced-motion: reduce) { .locale-pop.is-open, .locale-pop.is-closing { animation: none; } }
</style>
