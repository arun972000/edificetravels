---
import type { CollectionEntry } from 'astro:content';
import { getDict, fmt } from '../i18n';
import type { Locale } from '../i18n/config';
interface Props { review: CollectionEntry<'reviews'>; journeyTitle?: string; class?: string; locale?: Locale; }
const { review, journeyTitle, class: className = '', locale = 'en' } = Astro.props;
const t = getDict(locale);
const r = review.data;
const parts = r.name.replace(/[^\p{L}\s]/gu, '').split(/\s+/).filter(w => w && !['and', 'Dr', 'Mr', 'Mrs', 'Ms'].includes(w));
const when = [r.country, r.month && r.year ? `${r.month} ${r.year}` : r.year].filter(Boolean).join(', ');
const initials = ((parts[0]?.[0] ?? '') + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
---

<figure class:list={['flex h-full flex-col rounded-[24px] bg-bg-muted p-6', className]}>
  <div class="flex items-center justify-between">
    <div class="flex gap-0.5 text-brand" aria-label={fmt(t.common.outOfFive, { n: r.rating })} role="img">
      {Array.from({ length: 5 }).map((_, i) => (
        <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
          <path fill={i < r.rating ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.2" d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.7L10 14.8l-5.1 2.7 1-5.7-4.1-4 5.7-.8z" />
        </svg>
      ))}
    </div>
    {r.sample && <span class="rounded-pill bg-bg-elevated px-2.5 py-0.5 text-[0.72rem] font-bold text-ink-muted" title={t.common.sampleReviewNote}>{t.common.sample}</span>}
  </div>
  <blockquote class="mt-4 flex-1">
    <p class="font-display text-[1.2rem] leading-[1.45] text-ink">“{r.quote}”</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3 text-small">
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-ink text-[0.85rem] font-bold text-bg" aria-hidden="true">{initials}</span>
    <span class="min-w-0">
      <span class="block font-bold text-ink">{r.name}</span>
      {when && <span class="block text-ink-muted">{when}</span>}
      {r.source === 'Google' && (
        <span class="mt-0.5 flex items-center gap-1.5 text-ink-muted">
          <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.8Z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1Z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9Z"/></svg>
          {t.common.googleReview}
        </span>
      )}
      {journeyTitle && r.journey && (
        <span class="block text-ink-muted">Travelled on <a href={`/journeys/${r.journey}`} class="font-semibold underline underline-offset-2 hover:text-ink">{journeyTitle}</a></span>
      )}
    </span>
  </figcaption>
</figure>
