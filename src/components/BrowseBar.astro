---
/**
 * The ways to browse the site, named once and in the same order on every
 * index page: ready-made journeys, interests, places, or a journey of your
 * own. The current one is filled orange, so visitors always know where they
 * are and what the other pages are for.
 */
interface Props {
  current: 'journeys' | 'interests' | 'places';
  counts?: { journeys?: number; interests?: number; places?: number };
  class?: string;
}
const { current, counts = {}, class: className = '' } = Astro.props;
const items = [
  { id: 'journeys', href: '/journeys', title: 'Journeys', text: `${counts.journeys ? `${counts.journeys} ready-made` : 'Ready-made'} routes to start from`, icon: 'M3 17c3-6 6-6 9-3s6 3 9-3M5 19h.01M19 7h.01' },
  { id: 'interests', href: '/themes', title: 'By interest', text: `${counts.interests ? `${counts.interests} ways` : 'Ways'} in, by what you love`, icon: 'M12 21s-7-4.5-7-11a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 6.5-7 11-7 11Z' },
  { id: 'places', href: '/destinations', title: 'Places', text: `${counts.places ? `${counts.places} destinations` : 'Destinations'} in five regions`, icon: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z' },
  { id: 'own', href: '/plan', title: 'Your own', text: 'Tell us the idea; we draw the route', icon: 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z' },
] as const;
---

<nav aria-label="Ways to browse" class:list={['container-x', className]}>
  <ul class="grid grid-cols-2 gap-2 md:grid-cols-4">
    {items.map(it => {
      const on = it.id === current;
      return (
        <li>
          <a
            href={it.href}
            aria-current={on ? 'page' : undefined}
            data-track={it.id === 'own' ? 'plan_click' : undefined}
            class:list={[
              'press group flex h-full items-start gap-3 rounded-[20px] border p-3.5 transition-colors sm:p-4',
              on ? 'border-brand bg-brand text-[#1c1b1a]' : 'border-line bg-bg-elevated text-ink hover:border-brand',
            ]}
          >
            <span class:list={['grid h-10 w-10 shrink-0 place-items-center rounded-full', on ? 'bg-[#1c1b1a] text-brand' : 'bg-brand-soft text-brand-deep']} aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24"><path d={it.icon} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-[0.98rem] font-extrabold leading-tight">{it.title}</span>
              <span class:list={['mt-0.5 block text-[0.8rem] font-semibold leading-snug', on ? 'text-[#1c1b1a]' : 'text-ink-muted']}>{it.text}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
