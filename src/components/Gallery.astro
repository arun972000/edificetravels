---
import { Image } from 'astro:assets';
import { photo, hasPhoto } from '../lib/photos';
import { photoAlt } from '../data/photo-alt';
interface Props { slugs: string[]; captions?: Record<string, string>; }
const { slugs, captions = {} } = Astro.props;
const items = slugs.filter(hasPhoto);
---

{items.length > 0 && (
  <div class="grid grid-cols-2 gap-2 md:grid-cols-3 md:gap-3">
    {items.map((s, i) => (
      <figure class:list={['reveal-img relative overflow-hidden rounded-[20px]', i === 0 && 'col-span-2 row-span-2']}>
        <Image
          src={photo(s)}
          alt={captions[s] ?? photoAlt(s)}
          widths={[480, 800, 1200]}
          sizes={i === 0 ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 33vw, 50vw'}
          class="aspect-[4/3] h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
  </div>
)}
