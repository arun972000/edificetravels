---
/**
 * The brand, said once and large: the badge on a white disc, why the company
 * is called Edifice and the promise in numbers, beside a mosaic of six of
 * the places we send guests to (each opens its page). Black panel in the
 * logo's colours. The full constellation map lives on the destinations,
 * region, theme and journey pages, where it carries routes.
 */
import { Image } from 'astro:assets';
import badge from '../../assets/brand/edifice-travels-logo.png';
import BrandStats from '../BrandStats.astro';
import Pyramid from '../Pyramid.astro';
import { photo } from '../../lib/photos';
import { site } from '../../data/site';
import { getDict } from '../../i18n';
import type { Locale } from '../../i18n/config';
import { allDestinations, destinationsByIds } from '../../lib/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const places = await destinationsByIds(['agra', 'jaipur', 'udaipur', 'varanasi', 'alleppey', 'leh-ladakh']);
const total = (await allDestinations()).length;
---

<section class="py-6 md:py-10">
  <div class="px-3 md:px-4">
    <div class="relative isolate overflow-hidden rounded-[32px] bg-[#1c1b1a] text-white md:rounded-[40px]">
      <Pyramid size="clamp(18rem, 40vw, 34rem)" tone="night" opacity={0.06} class="pyramid-deco -left-16 -top-10 -z-10" />
      <div class="container-x grid gap-10 py-10 md:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-14">
        <div>
          <div class="reveal flex items-center gap-5">
            <span class="brand-disc grid shrink-0 place-items-center rounded-full bg-white p-1.5">
              <Image src={badge} alt="Edifice Travels" width={112} height={112} densities={[1, 2]} class="h-[5.5rem] w-[5.5rem] md:h-28 md:w-28" loading="lazy" />
            </span>
            <span class="flex flex-col gap-1.5">
              <span class="font-sans text-[1.15rem] font-extrabold uppercase leading-none tracking-[0.1em] md:text-[1.35rem]"><span class="text-brand">Edifice</span> Travels</span>
              <span class="text-[0.9rem] font-semibold text-white/70">{site.basedIn}</span>
            </span>
          </div>
          <span class="brand-tick-light reveal mt-8" aria-hidden="true"></span>
          <h2 class="reveal mt-4 text-h2 !text-white">{t.home.brandTitle}</h2>
          <p class="reveal mt-4 max-w-xl text-lead text-white/82">{t.home.brandText}</p>
          <p class="reveal mt-8 text-[1rem] font-extrabold text-brand">{t.home.statsTitle}</p>
          <BrandStats locale={locale} tone="night" class="mt-4" />
        </div>
        <div class="reveal">
          <ul class="mosaic grid grid-cols-3 gap-2 sm:gap-2.5" role="list">
            {places.map((p, i) => (
              <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
                <a href={`/destinations/${p.id}`} class="group press block h-full">
                  <div class="frame frame-accent h-full !rounded-[18px] sm:!rounded-[22px]">
                    <Image src={photo(p.data.heroImage)} alt="" widths={i === 0 ? [480, 720, 1000] : [240, 360, 520]} sizes={i === 0 ? '(min-width: 1024px) 26rem, 64vw' : '(min-width: 1024px) 13rem, 32vw'} quality={70} class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(20,18,16,0.85)_0%,rgba(20,18,16,0.1)_55%,transparent_75%)]" aria-hidden="true"></div>
                    <span class:list={['absolute inset-x-2.5 bottom-2 font-display leading-[1.05] text-white sm:inset-x-3 sm:bottom-3', i === 0 ? 'text-[1.5rem] sm:text-[1.9rem]' : 'text-[0.95rem] sm:text-[1.15rem]']}>{p.data.title}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <p class="text-[0.95rem] font-semibold text-white/80"><span class="font-display text-[1.6rem] text-brand">{total}</span> {t.home.statPlaces}</p>
            <a href="/destinations" class="press inline-flex min-h-11 items-center rounded-pill bg-brand px-5 text-[0.95rem] font-extrabold text-[#1c1b1a] transition-colors hover:bg-white">{t.home.mapLink}</a>
          </div>
        </div>
      </div>
      <div class="h-1.5 bg-brand" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .brand-disc { box-shadow: 0 0 0 3px var(--c-brand), 0 0 0 8px rgb(255 255 255 / 0.06); }
  .mosaic { grid-auto-rows: 7.5rem; }
  @media (min-width: 40rem) { .mosaic { grid-auto-rows: 10rem; } }
  @media (min-width: 64rem) { .mosaic { grid-auto-rows: 9.5rem; } }
  @media (min-width: 80rem) { .mosaic { grid-auto-rows: 11rem; } }
</style>
