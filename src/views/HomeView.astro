---
/**
 * The home page, built mobile first: a postcard that opens to the full
 * screen, the first choices within a thumb's reach, the journeys by feeling,
 * one day in India as stacking postcards, the regions, how planning works,
 * guests, the people, the guides, and a last postcard to begin. Rendered for
 * every locale; content names use translations where they exist.
 */
import { Image, getImage } from 'astro:assets';
import badge from '../assets/brand/edifice-travels-logo.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostcardHero from '../components/home/PostcardHero.astro';
import TripStarter from '../components/home/TripStarter.astro';
import JourneyFinder from '../components/home/JourneyFinder.astro';
import DayStack from '../components/home/DayStack.astro';
import RegionBento from '../components/home/RegionBento.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SpecialistCard from '../components/SpecialistCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import GuideCard from '../components/GuideCard.astro';
import Button from '../components/Button.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import LocalInfo from '../components/LocalInfo.astro';
import Rangoli from '../components/decor/Rangoli.astro';
import Diya from '../components/decor/Diya.astro';
import Buta from '../components/decor/Buta.astro';
import { photo } from '../lib/photos';
import { waMessages } from '../lib/whatsapp';
import { getDict } from '../i18n';
import { localizedPath, type Locale } from '../i18n/config';
import { site } from '../data/site';
import { allJourneys, allRegions, allReviews, allSpecialists, featuredGuides } from '../lib/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const lp = (p: string) => localizedPath(p, locale);

const journeys = await allJourneys();
const regions = await allRegions();
const reviews = await allReviews();
const specialists = await allSpecialists();
const guides = await featuredGuides(4);
const og = await getImage({ src: photo('hero-taj-dawn'), width: 1200, format: 'jpeg' });

const manifestoWords = t.home.manifesto.split(/\s+/);
const finalWords = t.home.finalTitle.split(/\s+/);
---

<BaseLayout title={t.meta.homeTitle} description={t.meta.homeDescription} image={og.src} locale={locale}>
  <PostcardHero locale={locale} regions={regions} />

  <TripStarter locale={locale} regions={regions} />

  <!-- The feeling, said once, lighting up as it is read. -->
  <section class="relative isolate overflow-hidden py-16 md:py-28">
    <Rangoli class="absolute left-1/2 top-1/2 -z-10 -translate-x-1/2 -translate-y-1/2" />
    <div class="container-x">
      <div class="reveal mb-6 flex justify-center"><Diya /></div>
      <p class="lit mx-auto max-w-[28ch] text-center font-display text-[clamp(1.75rem,1.2rem+2.6vw,3.6rem)] leading-[1.16] tracking-[-0.02em] text-ink md:max-w-[32ch]">
        {manifestoWords.map((w, i) => <><span class="word">{w}</span>{i < manifestoWords.length - 1 ? ' ' : ''}</>)}
      </p>
      <div class="reveal mt-10 flex flex-col items-center gap-4">
        <Button href={lp('/about')} variant="secondary">{t.nav.about}</Button>
        <LocalInfo locale={locale} show={['reply-window']} class="text-center" />
      </div>
    </div>
  </section>

  <Buta class="mt-2" />

  <JourneyFinder journeys={journeys} locale={locale} />

  <DayStack locale={locale} />

  <RegionBento regions={regions} locale={locale} />

  <HowItWorks locale={locale} />

  <Buta class="mt-4" />

  <!-- Guests -->
  <section class="py-14 md:py-24">
    <div class="container-x">
      <SectionHeading title={t.home.voicesTitle}>
        <a slot="action" href="/reviews" class="chip">{t.home.voicesLabel}</a>
      </SectionHeading>
      <ul class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-3" role="list">
        {reviews.map(r => (
          <li class="reveal">
            <ReviewCard review={r} locale={locale} class="h-full" />
          </li>
        ))}
        <li class="reveal">
          <a href={site.googleReviews} target="_blank" rel="noopener" class="press flex h-full flex-col justify-between gap-8 rounded-[24px] bg-night p-6 text-white">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-white" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.8Z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1Z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9Z"/></svg>
            </span>
            <span class="block">
              <span class="block font-display text-[1.45rem] leading-tight">{t.home.googleTitle}</span>
              <span class="mt-2 block text-[0.95rem] leading-relaxed text-white/75">{t.home.googleText}</span>
              <span class="mt-5 inline-flex rounded-pill bg-white px-4 py-2 text-[0.9rem] font-bold text-[#1b1d21]">{t.home.googleLink}</span>
            </span>
          </a>
        </li>
      </ul>
      {locale !== 'en' && <p class="mt-4 text-[0.85rem] text-ink-muted">{t.home.reviewOriginal}</p>}
    </div>
  </section>

  <!-- The people -->
  <section class="py-14 md:py-24">
    <div class="container-x">
      <SectionHeading title={t.home.peopleTitle} lead={t.home.peopleLead} />
      <div class="mt-8 grid grid-cols-1 gap-3 md:mt-12 lg:grid-cols-[1.5fr_1fr]">
        <figure class="reveal flex flex-col justify-between rounded-[28px] bg-night p-6 text-white sm:p-8">
          <div class="space-y-4 font-display text-[1.2rem] leading-[1.5] text-white/95 md:text-[1.3rem]">
            {t.home.letter.map(para => <p>{para}</p>)}
          </div>
          <figcaption class="mt-8 flex items-center gap-3 text-[0.92rem] font-bold text-white/80">
            <span class="block h-10 w-10 shrink-0 overflow-hidden rounded-full bg-white" aria-hidden="true">
              <Image src={badge} alt="" width={40} height={40} densities={[1, 2, 3]} class="h-full w-full" loading="lazy" />
            </span>
            {t.home.letterSign}
          </figcaption>
        </figure>
        {specialists.slice(0, 1).map(s => (
          <div class="reveal"><SpecialistCard specialist={s} whatsapp={waMessages.general()} compact locale={locale} class="h-full" /></div>
        ))}
      </div>
      <div class="reveal mt-6"><Button href={`${lp('/about')}#specialists`} variant="ghost">{t.home.meetTeam}</Button></div>
    </div>
  </section>

  <!-- Before you go -->
  <section class="py-14 md:py-24">
    <div class="container-x">
      <SectionHeading title={t.home.guidesTitle}>
        <a slot="action" href="/guide" class="chip">{t.home.guidesLink}</a>
      </SectionHeading>
    </div>
    <ul class="swipe mt-8" role="list">
      {guides.map(g => <li class="reveal"><GuideCard guide={g} locale={locale} /></li>)}
    </ul>
  </section>

  <!-- Begin: a last postcard. -->
  <section class="px-3 pt-10 md:px-4 md:pt-16">
    <div class="relative isolate flex min-h-[86svh] items-end overflow-hidden rounded-[28px] bg-[#16181b] text-white md:min-h-[80svh] md:items-center md:rounded-[36px]">
      <div class="reveal-img absolute inset-0 -z-10 !rounded-none">
        <Image src={photo('traveller-couple')} alt="" widths={[720, 1280, 1920, 2400]} sizes="100vw" class="h-full w-full object-cover" loading="lazy" decoding="async" />
      </div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(10,11,13,0.85)_0%,rgba(10,11,13,0.4)_50%,rgba(10,11,13,0.25)_100%)]" aria-hidden="true"></div>
      <div class="container-x py-12 md:py-20 md:text-center">
        <h2 class="split max-w-[14ch] text-[clamp(2.75rem,1.9rem+4.6vw,6.5rem)] leading-[0.95] tracking-[-0.03em] text-white md:mx-auto">
          {finalWords.map((w, i) => <><span class="w"><span style={`--i:${i}`}>{w}</span></span>{i < finalWords.length - 1 ? ' ' : ''}</>)}
        </h2>
        <p class="reveal mt-5 max-w-xl text-[1.05rem] leading-relaxed text-white/85 md:mx-auto md:text-lead">{t.home.finalLead}</p>
        <div class="reveal mt-8 flex flex-wrap gap-2.5 md:justify-center">
          <Button href={lp('/plan')} size="lg" track="plan_click">{t.common.planTrip}</Button>
          <WhatsAppButton href={waMessages.general()} size="lg" variant="inverse" label={t.common.whatsappSpecialist} trackLabel="home-final" locale={locale} />
        </div>
        <div class="reveal mt-7 md:flex md:justify-center">
          <LocalInfo locale={locale} show={['reply-window', 'flight']} light />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
