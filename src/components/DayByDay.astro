---
/**
 * The itinerary as a timeline: a rail on the left with a stop for each day,
 * and a soft card per day. The rail fills with colour as you read down.
 * Long journeys show the first days and a button for the rest.
 */
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
import { photoAlt } from '../data/photo-alt';

interface Day {
  day: number;
  title: string;
  location: string;
  drive?: string;
  text: string;
  stay?: { comfort: string; premium: string; luxury: string };
  image?: string;
}
interface Props { days: Day[]; collapseAfter?: number; }
const { days, collapseAfter = 4 } = Astro.props;
---

<div class="day-by-day" data-collapsed={days.length > collapseAfter ? 'true' : 'false'}>
  <ol class="timeline relative">
    <span class="rail absolute bottom-6 left-[1.1rem] top-2 w-0.5 rounded-full bg-line md:left-[1.35rem]" aria-hidden="true"><span class="rail-fill absolute inset-0 origin-top rounded-full bg-brand" data-rail-fill></span></span>
    {days.map((d, i) => (
      <li id={`day-${d.day}`} class:list={['relative pb-6 pl-12 md:pl-16', i >= collapseAfter && 'day-extra']}>
        <span class="absolute left-0 top-0 grid h-9 w-9 place-items-center rounded-full bg-brand text-[0.85rem] font-extrabold text-on-brand ring-4 ring-bg md:h-11 md:w-11 md:text-[0.95rem]" aria-hidden="true">{d.day}</span>
        <article class="reveal rounded-[24px] bg-bg-muted p-4 sm:p-6">
          <div class="grid gap-5 lg:grid-cols-[1fr_17rem] lg:gap-8">
            <div class="min-w-0">
              <p class="text-[0.85rem] font-bold text-brand-deep">Day {d.day}, {d.location}</p>
              <h3 class="mt-1.5 font-display text-[clamp(1.45rem,1.25rem+0.8vw,1.9rem)] font-normal leading-[1.1] tracking-[-0.02em] text-ink">{d.title}</h3>
              {d.drive && (
                <p class="mt-3 inline-flex items-center gap-1.5 rounded-pill bg-bg-elevated px-3 py-1.5 text-[0.82rem] font-semibold text-ink-soft">
                  <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 6.4A2 2 0 0 0 17 5H7a2 2 0 0 0-1.9 1.4L3 12v7a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1h12v1a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-7zM7.5 15a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m9 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3M5.8 11l1.2-4h10l1.2 4z"/></svg>
                  {d.drive}
                </p>
              )}
              <p class="mt-3 max-w-2xl text-[0.98rem] leading-relaxed text-ink-soft">{d.text}</p>
              {d.stay && (
                <dl class="mt-4 divide-y divide-line rounded-[16px] bg-bg-elevated px-3.5 text-[0.86rem] sm:grid sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-0">
                  <div class="flex justify-between gap-3 py-2 sm:block sm:px-3.5 sm:py-3"><dt class="shrink-0 font-bold text-brand-deep">Comfort</dt><dd class="text-right font-semibold text-ink sm:mt-0.5 sm:text-left">{d.stay.comfort}</dd></div>
                  <div class="flex justify-between gap-3 py-2 sm:block sm:px-3.5 sm:py-3"><dt class="shrink-0 font-bold text-brand-deep">Premium</dt><dd class="text-right font-semibold text-ink sm:mt-0.5 sm:text-left">{d.stay.premium}</dd></div>
                  <div class="flex justify-between gap-3 py-2 sm:block sm:px-3.5 sm:py-3"><dt class="shrink-0 font-bold text-brand-deep">Luxury</dt><dd class="text-right font-semibold text-ink sm:mt-0.5 sm:text-left">{d.stay.luxury}</dd></div>
                </dl>
              )}
            </div>
            {d.image && (
              <div class="reveal-img relative overflow-hidden rounded-[18px]">
                <Image src={photo(d.image)} alt={photoAlt(d.image)} widths={[360, 560, 800]} sizes="(min-width: 1024px) 17rem, 90vw" class="aspect-[4/3] h-full w-full object-cover" loading="lazy" decoding="async" />
              </div>
            )}
          </div>
        </article>
      </li>
    ))}
  </ol>
  {days.length > collapseAfter && (
    <button type="button" class="day-toggle press ml-12 mt-2 inline-flex h-12 items-center gap-2 rounded-pill bg-ink px-6 font-bold text-bg transition-colors hover:bg-brand hover:text-on-brand md:ml-16" aria-expanded="false">
      <span class="when-collapsed">Show all {days.length} days</span>
      <span class="when-expanded">Show fewer days</span>
    </button>
  )}
</div>

<style>
  html.js .day-by-day[data-collapsed="true"] .day-extra { display: none; }
  html.js .day-by-day[data-collapsed="true"] .when-expanded { display: none; }
  html.js .day-by-day[data-collapsed="false"] .when-collapsed { display: none; }
  html:not(.js) .day-toggle { display: none; }
  .rail-fill { transform: scaleY(var(--fill, 0)); transition: transform 0.25s linear; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.day-by-day').forEach(root => {
    const btn = root.querySelector<HTMLButtonElement>('.day-toggle');
    btn?.addEventListener('click', () => {
      const collapsed = root.dataset.collapsed === 'true';
      root.dataset.collapsed = collapsed ? 'false' : 'true';
      btn.setAttribute('aria-expanded', String(collapsed));
      if (!collapsed) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      root.querySelectorAll('.day-extra .reveal, .day-extra .reveal-img').forEach(el => el.classList.add('is-visible'));
    });
    // A hash link to a hidden day (from the route map) expands the list.
    const expandForHash = () => {
      const target = location.hash && root.querySelector(location.hash);
      if (target && target.classList.contains('day-extra') && root.dataset.collapsed === 'true') btn?.click();
    };
    expandForHash();
    window.addEventListener('hashchange', expandForHash);

    // The rail fills as the reader moves down the days.
    const rail = root.querySelector<HTMLElement>('.timeline');
    const fill = root.querySelector<HTMLElement>('[data-rail-fill]');
    if (rail && fill && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let raf = 0;
      const tick = () => {
        raf = 0;
        const r = rail.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (window.innerHeight * 0.6 - r.top) / r.height));
        fill.style.setProperty('--fill', p.toFixed(3));
      };
      window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
      tick();
    } else if (fill) fill.style.setProperty('--fill', '1');
  });
</script>
