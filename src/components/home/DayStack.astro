---
/**
 * "One day in India": six moments, from first light to the last lamp, as
 * photo cards in time order. Three across on wide screens, a sideways row on
 * phones, so the whole day takes one screen instead of six. The moment that
 * matches the time in India right now carries a live badge and an orange
 * ring. Cards grow with their text, so no translation is ever cut off.
 */
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { photo } from '../../lib/photos';
import { getDict } from '../../i18n';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const slugs = ['agra-taj', 'jaipur-hawa-mahal', 'alleppey-houseboat', 'hero-rajasthan-desert', 'yoga-sunrise', 'udaipur-lake'];
const steps = t.home.daySteps.map((s, i) => ({ ...s, slug: slugs[i] }));
---

<section class="py-10 md:py-16" data-daystack>
  <div class="container-x">
    <SectionHeading title={t.home.dayTitle} lead={t.home.dayLead} />
  </div>
  <ol class="swipe day-row mt-7 md:mt-10 lg:!grid-flow-row lg:!grid-cols-3 lg:!overflow-visible" role="list" tabindex="0" aria-label={t.home.dayTitle}>
    {steps.map(s => (
      <li class="reveal" data-day-item data-time={s.time}>
        <article class="day-card relative isolate flex h-full min-h-[26rem] flex-col justify-end overflow-hidden rounded-[26px] bg-[#1c1b1a] text-white lg:min-h-[24rem]">
          <Image src={photo(s.slug)} alt="" widths={[420, 640, 900]} sizes="(min-width: 1024px) 26rem, 80vw" quality={66} class="fade-img absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(20,18,16,0.92)_0%,rgba(20,18,16,0.55)_45%,rgba(20,18,16,0.1)_80%)]" aria-hidden="true"></div>
          <div class="p-5 sm:p-6">
            <p class="flex flex-wrap items-center gap-2">
              <span class="font-display text-[2.6rem] leading-none tracking-[-0.03em] tabular-nums text-brand">{s.time}</span>
              <span class="text-[0.85rem] font-bold text-[#ff8a4c]">{s.place}</span>
              <span class="day-now hidden items-center gap-1.5 rounded-pill bg-brand px-2.5 py-1 text-[0.75rem] font-extrabold text-[#1c1b1a]" data-day-now><span class="live-dot"></span>{t.home.dayNow}</span>
            </p>
            <h3 class="mt-3 font-display text-[1.45rem] font-normal leading-[1.1] tracking-[-0.015em] !text-white">{s.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-white/82">{s.text}</p>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .day-now.is-on { display: inline-flex; }
  .day-card.is-now { box-shadow: 0 0 0 3px var(--c-brand); }
</style>

<script>
  // Mark the moment that matches the time in India right now.
  document.querySelectorAll<HTMLElement>('[data-daystack]').forEach(root => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-day-item]'));
    const ist = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date());
    const toMin = (hm: string) => { const [h, m] = hm.split(':').map(Number); return h * 60 + m; };
    const now = toMin(ist);
    const times = items.map(s => toMin(s.dataset.time ?? '00:00'));
    let live = times.length - 1;
    for (let k = 0; k < times.length; k++) if (now >= times[k]) live = k;
    if (now < times[0]) live = times.length - 1;
    const item = items[live];
    item?.querySelector('[data-day-now]')?.classList.add('is-on');
    item?.querySelector('.day-card')?.classList.add('is-now');
  });
</script>
