---
/**
 * The person, or team, who answers. Shows a portrait only when a real one
 * exists in src/assets/photos; otherwise the company badge for the team or a
 * monogram for a person, never a stranger's face.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { photo, hasPhoto } from '../lib/photos';
import badge from '../assets/brand/edifice-travels-logo.png';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../data/site';
import { getDict, fmt, roleCopy } from '../i18n';
import type { Locale } from '../i18n/config';

interface Props {
  specialist: CollectionEntry<'specialists'>;
  whatsapp: string;
  /** Line above the name, e.g. "I design this journey". */
  context?: string;
  compact?: boolean;
  class?: string;
  locale?: Locale;
}
const { specialist, whatsapp, context, compact = false, class: className = '', locale = 'en' } = Astro.props;
const s = specialist.data;
const t = getDict(locale);
const role = roleCopy(specialist.id, locale, s.role);
const initials = s.name.split(' ').map(w => w[0]).slice(0, 2).join('');
const firstName = s.name.split(' ')[0];
const isTeam = specialist.id === 'team';
const portrait = s.portrait && hasPhoto(s.portrait) ? s.portrait : null;
---

<aside class:list={['flex flex-col rounded-[24px] border border-line bg-bg-elevated p-5 sm:p-6', className]} aria-label={`${t.common.yourSpecialist}: ${s.name}`}>
  <div class="flex items-center gap-4">
    <div class="relative h-16 w-16 shrink-0">
      <div class="h-full w-full overflow-hidden rounded-full">
        {portrait ? (
          <Image src={photo(portrait)} alt={s.name} width={128} height={128} class="h-full w-full object-cover" loading="lazy" />
        ) : isTeam ? (
          <span class="block h-full w-full bg-white" aria-hidden="true">
            <Image src={badge} alt="" width={64} height={64} densities={[1, 2]} class="h-full w-full" loading="lazy" />
          </span>
        ) : (
          <span class="monogram flex h-full w-full items-center justify-center font-display text-[1.5rem] text-white" aria-hidden="true">{initials}</span>
        )}
      </div>
      <span class="live-dot absolute bottom-0.5 right-0.5 ring-[3px] ring-bg-elevated" data-office-status-dot></span>
    </div>
    <div class="min-w-0">
      <p class="text-[0.82rem] font-semibold text-ink-muted">{context ?? t.common.yourSpecialist}</p>
      <p class="text-[1.2rem] font-extrabold leading-tight text-ink">{s.name}</p>
      <p class="text-[0.88rem] text-ink-soft">{role}, {s.basedIn}</p>
    </div>
  </div>
  <p class="mt-4 inline-flex w-fit items-center gap-2 rounded-pill bg-bg-muted px-3 py-1.5 text-[0.82rem] font-bold text-ink" data-office-status data-on={t.home.onlineNow} data-off={t.home.backAt}>
    <span data-office-status-text>{t.home.onlineNow}</span>
  </p>
  {s.sample && <span class="mt-2 text-[0.75rem] font-semibold text-ink-muted" title={t.common.sampleProfileNote}>{t.common.sampleProfile}</span>}
  {!compact && locale === 'en' && <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-soft">{s.bio}</p>}
  <p class="mt-3 text-[0.85rem] text-ink-muted">{fmt(t.common.speaks, { languages: s.languages.join(', ') })}.{s.yearsInTravel && ` ${fmt(t.common.yearsDesigning, { n: s.yearsInTravel })}.`}</p>
  <div class="mt-5">
    <WhatsAppButton href={whatsapp} label={isTeam ? t.common.whatsappSpecialist : fmt(t.common.whatsappName, { name: firstName })} trackLabel="specialist-card" locale={locale} class="w-full [&>a]:w-full" />
  </div>
  <p class="mt-3 text-center text-[0.85rem] text-ink-muted">{t.common.orEmail} <a href={`mailto:${site.email}`} class="font-semibold underline underline-offset-2 hover:text-ink">{site.email}</a></p>
</aside>

<style>
  .monogram { background: radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.28), transparent 55%), linear-gradient(140deg, var(--c-brand) 0%, #c25f0f 60%, #7a3808 100%); }
</style>

<script>
  // Live status: replying during office hours in India (9 am to 8 pm IST).
  const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));
  const on = hour >= 9 && hour < 20;
  document.querySelectorAll<HTMLElement>('[data-office-status]').forEach(el => {
    const txt = el.querySelector<HTMLElement>('[data-office-status-text]');
    if (txt) txt.textContent = (on ? el.dataset.on : el.dataset.off) ?? '';
  });
  document.querySelectorAll<HTMLElement>('[data-office-status-dot]').forEach(d => d.classList.toggle('is-off', !on));
</script>
