---
/**
 * Section heading. A short two-tone rule in the logo's orange and black sits
 * above the title, so every section carries the brand without highlighting a
 * word in the headline. The title rises word by word as it scrolls into view;
 * the lead follows. `eyebrow` prints a small orange label above the title:
 * use it only when it adds information (a count, a step, a place). An
 * optional `action` slot sits to the right on wide screens. `tone` adapts
 * the colours for black (`dark`) or orange (`brand`) panels. `chapter` and
 * `emphasis` are accepted for old call sites and ignored.
 */
interface Props {
  eyebrow?: string;
  chapter?: string;
  title: string;
  emphasis?: string;
  lead?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  size?: 'h1' | 'h2' | 'display';
  class?: string;
  /** Kept for old call sites: same as tone="dark". */
  dark?: boolean;
  tone?: 'light' | 'dark' | 'brand';
  /** Hide the two-tone rule (for headings set inside small cards). */
  tick?: boolean;
}
const { title, lead, eyebrow, align = 'left', as: Tag = 'h2', size = 'h2', class: className = '', dark = false, tick = true } = Astro.props;
const tone = Astro.props.tone ?? (dark ? 'dark' : 'light');
const words = title.split(/\s+/).filter(Boolean);
const sizeClass = size === 'h1' ? 'text-h1' : size === 'display' ? 'text-[clamp(2.75rem,1.9rem+4.4vw,6rem)] leading-[0.95]' : 'text-h2';
const hasAction = Astro.slots.has('action');
const titleColour = tone === 'dark' ? '!text-white' : tone === 'brand' ? '!text-on-brand' : 'text-ink';
const leadColour = tone === 'dark' ? 'text-white/80' : tone === 'brand' ? 'text-on-brand font-medium' : 'text-ink-soft';
const eyebrowColour = tone === 'dark' ? 'text-brand' : tone === 'brand' ? 'text-on-brand' : 'text-brand-deep';
const tickClass = tone === 'dark' ? 'brand-tick-light' : tone === 'brand' ? 'brand-tick-ink' : 'brand-tick';
---

<div class:list={['flex flex-col gap-5 md:flex-row md:items-end md:justify-between', align === 'center' && 'md:flex-col md:items-center text-center', className]}>
  <div class:list={['split max-w-3xl', align === 'center' && 'mx-auto']}>
    {tick && <span class:list={['reveal mb-4 md:mb-5', tickClass, align === 'center' && 'mx-auto']} aria-hidden="true"></span>}
    {eyebrow && <p class:list={['reveal mb-3 text-[0.9rem] font-extrabold', eyebrowColour]}>{eyebrow}</p>}
    <Tag class:list={[sizeClass, titleColour]}>
      {words.map((w, i) => (
        <><span class="w"><span style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 ? ' ' : ''}</>
      ))}
    </Tag>
    {lead && <p class:list={['reveal mt-4 max-w-2xl text-lead md:mt-5', align === 'center' && 'mx-auto', leadColour]}>{lead}</p>}
  </div>
  {hasAction && <div class="reveal shrink-0"><slot name="action" /></div>}
</div>
