---
/**
 * Section heading. The title rises word by word as it scrolls into view;
 * the lead follows. An optional `action` slot sits to the right on wide
 * screens (for "See all" links). `eyebrow`, `chapter` and `emphasis` are
 * accepted for old call sites and ignored.
 */
interface Props {
  eyebrow?: string;
  chapter?: string;
  title: string;
  emphasis?: string;
  lead?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  size?: 'h1' | 'h2' | 'display';
  class?: string;
  dark?: boolean;
}
const { title, lead, align = 'left', as: Tag = 'h2', size = 'h2', class: className = '', dark = false } = Astro.props;
const words = title.split(/\s+/).filter(Boolean);
const sizeClass = size === 'h1' ? 'text-h1' : size === 'display' ? 'text-[clamp(2.75rem,1.9rem+4.4vw,6rem)] leading-[0.95]' : 'text-h2';
const hasAction = Astro.slots.has('action');
---

<div class:list={['flex flex-col gap-5 md:flex-row md:items-end md:justify-between', align === 'center' && 'md:flex-col md:items-center text-center', className]}>
  <div class:list={['split max-w-3xl', align === 'center' && 'mx-auto']}>
    <Tag class:list={[sizeClass, dark ? '!text-white' : 'text-ink']}>
      {words.map((w, i) => (
        <><span class="w"><span style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 ? ' ' : ''}</>
      ))}
    </Tag>
    {lead && <p class:list={['reveal mt-4 max-w-2xl text-lead md:mt-5', align === 'center' && 'mx-auto', dark ? 'text-white/80' : 'text-ink-soft']}>{lead}</p>}
  </div>
  {hasAction && <div class="reveal shrink-0"><slot name="action" /></div>}
</div>
