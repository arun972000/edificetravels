---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import JourneyCard from '../components/JourneyCard.astro';
import Pyramid from '../components/Pyramid.astro';
import { featuredJourneys } from '../lib/content';
const journeys = await featuredJourneys(3);
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <div class="container-x py-12 md:py-20">
    <div class="relative isolate overflow-hidden rounded-[32px] bg-brand px-6 py-12 text-[#1c1b1a] sm:px-10 md:py-16">
      <Pyramid size="clamp(12rem, 28vw, 24rem)" tone="ink" opacity={0.12} class="pyramid-deco -bottom-10 -right-6 -z-10" />
      <SectionHeading as="h1" size="h1" title="That road does not go anywhere" lead="The page may have moved. These journeys are all still here." tone="brand" />
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/" variant="dark">Home</Button>
        <Button href="/journeys" variant="secondary">All journeys</Button>
      </div>
    </div>
    <div class="mt-12 grid gap-x-4 gap-y-10 sm:grid-cols-2 md:grid-cols-3">
      {journeys.map(j => <JourneyCard journey={j} />)}
    </div>
  </div>
</BaseLayout>
