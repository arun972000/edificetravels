---
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import JourneyCard from '../../components/JourneyCard.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import SpecialistCard from '../../components/SpecialistCard.astro';
import Button from '../../components/Button.astro';
import RouteMap from '../../islands/RouteMap';
import { photo } from '../../lib/photos';
import { photoAlt } from '../../data/photo-alt';
import { waMessages } from '../../lib/whatsapp';
import { breadcrumbLd } from '../../lib/seo';
import { journeysByRegion, destinationsByRegion, specialistById } from '../../lib/content';

export async function getStaticPaths() {
  const regions = await getCollection('regions');
  return regions.map(r => ({ params: { id: r.id }, props: { region: r } }));
}

const { region } = Astro.props;
const d = region.data;
const { Content } = await render(region);
const journeys = await journeysByRegion(region.id);
const destinations = await destinationsByRegion(region.id);
const specialist = await specialistById(d.specialist);
const wa = waMessages.region(d.title);
const og = await getImage({ src: photo(d.heroImage), width: 1200, format: 'jpeg' });
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Destinations', href: '/destinations' }, { name: d.title, href: `/regions/${region.id}` }];
const stops = destinations.map(x => ({ name: x.data.title, lat: x.data.lat, lng: x.data.lng, href: `/destinations/${x.id}` }));
---

<BaseLayout title={d.seo.title ?? `${d.title}: private journeys and where to go`} description={d.seo.description} transparentHeader jsonLd={[breadcrumbLd(crumbs)]} image={og.src}>
  <Hero image={photo(d.heroImage)} alt={photoAlt(d.heroImage, d.title)} title={d.title} lead={d.tagline} breadcrumbs={crumbs} height="tall" primary={{ href: '/plan', label: `Plan ${d.title}`, track: 'plan_click' }} whatsapp={wa} />

  <section class="container-x grid grid-cols-1 gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,23rem)] lg:gap-16 md:py-16">
    <div class="prose-editorial"><Content /></div>
    <aside class="space-y-3 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:self-start">
      <SpecialistCard specialist={specialist} whatsapp={wa} context={`Ask us about ${d.title}`} />
      <div class="reveal rounded-[24px] bg-bg-muted p-5 sm:p-6">
        <h2 class="font-sans text-[1rem] font-extrabold tracking-normal text-ink">Best for</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {d.bestFor.map(b => <li class="rounded-pill bg-bg-elevated px-3.5 py-1.5 text-[0.9rem] font-semibold text-ink">{b}</li>)}
        </ul>
      </div>
    </aside>
  </section>

  <section class="py-6 md:py-10">
    <div class="container-x">
     <div class="rounded-[32px] bg-bg-muted px-5 py-10 sm:px-8 md:px-12 md:py-14">
      <SectionHeading title={`Where to go in ${d.title}`} />
      <div class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {d.whereToGo.map(w => (
          <div class="reveal rounded-[22px] bg-bg-elevated p-5">
            <h3 class="text-h3 text-ink">{w.destination ? <a href={`/destinations/${w.destination}`} class="underline decoration-brand/50 underline-offset-4 hover:text-brand-deep">{w.name}</a> : w.name}</h3>
            <p class="mt-2 text-small text-ink-soft">{w.blurb}</p>
          </div>
        ))}
      </div>
     </div>
    </div>
  </section>

  <section class="container-x grid gap-10 py-14 lg:grid-cols-2 lg:gap-14 md:py-20">
    <div>
      <SectionHeading title={`When to go to ${d.title}`} />
      <dl class="mt-8 grid gap-2">
        {d.whenToGo.map(w => (
          <div class="reveal grid gap-1 rounded-[18px] bg-bg-muted px-4 py-3.5 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-[1rem] font-extrabold text-ink">{w.months}</dt>
            <dd class="text-small text-ink-soft">{w.note}</dd>
          </div>
        ))}
      </dl>
    </div>
    {stops.length >= 2 && (
      <div>
        <RouteMap client:visible stops={stops} mode="constellation" title={`${d.title} on the map`} />
      </div>
    )}
  </section>

  {journeys.length > 0 && (
    <section class="container-x py-8 md:py-12">
      <SectionHeading title={`Our journeys through ${d.title}`} />
      <div class="mt-8 grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {journeys.map(j => <JourneyCard journey={j} />)}
      </div>
    </section>
  )}

  {destinations.length > 0 && (
    <section class="container-x py-16 md:py-20">
      <SectionHeading title={`Destinations in ${d.title}`} />
      <div class="mt-8 grid grid-cols-2 gap-x-3 gap-y-8 lg:grid-cols-4 lg:gap-x-5">
        {destinations.map(x => <DestinationCard destination={x} />)}
      </div>
    </section>
  )}

  <section class="container-x pb-16">
    <div class="reveal rounded-[30px] bg-night p-6 text-white sm:p-10 md:p-14">
      <h2 class="text-h2 !text-white">Plan your time in {d.title}</h2>
      <p class="mt-3 max-w-2xl text-lead text-white/80">Answer six short questions, or send us one message. Your proposal comes back within 48 hours.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/plan" size="lg" track="plan_click">Plan your trip</Button>
      </div>
    </div>
  </section>
</BaseLayout>
