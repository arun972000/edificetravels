---
/**
 * Guest stories: the real reviews, quoted exactly, with where they were
 * first published, the journey those guests took, what every guest can
 * expect, and an honest invitation to add a review. Nothing is invented.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Testimonials from '../components/Testimonials.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JourneyCard from '../components/JourneyCard.astro';
import Button from '../components/Button.astro';
import Pyramid from '../components/Pyramid.astro';
import { site } from '../data/site';
import { getDict } from '../i18n';
import { allReviews, allJourneys, relatedJourneys } from '../lib/content';
import { breadcrumbLd } from '../lib/seo';

const t = getDict('en');
const reviews = await allReviews();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guest stories', href: '/reviews' }];
const journeys = await allJourneys();
const reviewed = journeys.filter(j => reviews.some(r => r.data.journey === j.id));
const alongside = reviewed[0] ? await relatedJourneys(reviewed[0], 2) : [];
const sources = [...new Set(reviews.map(r => r.data.source).filter(Boolean))];
const icons = [
  'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12ZM8.5 11h.01M12 11h.01M15.5 11h.01',
  'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Zm0 0v5h5M9 13h6M9 17h4',
  'M5 17h14l-1.4-6.3A2 2 0 0 0 15.7 9H8.3a2 2 0 0 0-1.9 1.7ZM7 17v2M17 17v2M7.5 13.5h.01M16.5 13.5h.01',
];
---

<BaseLayout title="Guest stories and testimonials" description="What travellers told us after their journeys with Edifice Travels, quoted exactly as they wrote them, with room to share your own story." jsonLd={[breadcrumbLd(crumbs)]}>
  <div class="container-x pt-8 md:pt-14">
    <Breadcrumbs items={crumbs} />
  </div>
  <Testimonials reviews={reviews} as="h1" title="Guest stories" lead="What travellers told us once they were home, quoted exactly as they wrote it, spelling and all." showAll={false} />

  <!-- Where the words come from -->
  <section class="container-x">
    <div class="grid gap-3 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <div class="reveal relative isolate overflow-hidden rounded-[28px] bg-[#1c1b1a] p-6 text-white sm:p-9">
        <Pyramid size="11rem" tone="night" opacity={0.08} class="pyramid-deco -bottom-6 -right-6 -z-10" />
        <h2 class="font-display text-[clamp(1.6rem,1.3rem+1.2vw,2.3rem)] leading-tight !text-white">Where these words come from</h2>
        <p class="mt-4 text-[1rem] leading-relaxed text-white/80">Every review on this site was first published by the guest on {sources.length ? sources.join(' and ') : 'a public review site'}, and we quote it word for word. We don't edit them, pick out the best lines, or show ratings we can't trace back to a real person.</p>
        <p class="mt-3 text-[1rem] leading-relaxed text-white/80">We're a small team, and we'd rather show a few real reviews than many we can't stand behind. More arrive as guests come home.</p>
        <div class="mt-6"><Button href={site.googleReviews} external>Read our Google listing</Button></div>
      </div>
      <a href={site.googleReviews} target="_blank" rel="noopener" class="reveal press group flex flex-col justify-between gap-6 rounded-[28px] bg-brand p-6 text-[#1c1b1a] sm:p-9">
        <span>
          <span class="block font-display text-[clamp(1.6rem,1.3rem+1.2vw,2.3rem)] leading-tight">A few lines for the next traveller</span>
          <span class="mt-3 block text-[1rem] font-medium leading-relaxed">A few honest lines on Google help the next traveller decide, and they help us more than any advertising could. Tell people what worked and what didn't.</span>
        </span>
        <span class="inline-flex w-fit items-center gap-2 rounded-pill bg-[#1c1b1a] px-5 py-3 text-[0.98rem] font-bold text-white transition-colors group-hover:bg-white group-hover:text-[#1c1b1a]">Write a Google review</span>
      </a>
    </div>
  </section>

  {reviewed.length > 0 && (
    <section class="container-x pt-12 md:pt-16">
      <SectionHeading title="The journey these guests took" lead="Our Kashmir route as it stands today, with the journeys that pair well with it." />
      <div class="mt-8 grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {[...reviewed, ...alongside].map(j => <JourneyCard journey={j} />)}
      </div>
    </section>
  )}

  <!-- What every guest can expect -->
  <section class="container-x pt-12 md:pt-16">
    <SectionHeading title="What every guest can expect" lead="The promises behind every journey, whoever writes the next review." />
    <ul class="mt-8 grid gap-3 md:grid-cols-3">
      {t.home.promises.map((p, i) => (
        <li class="reveal flex items-start gap-4 rounded-[24px] border border-line border-t-[6px] border-t-brand bg-bg-elevated p-5 sm:p-6">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#1c1b1a] text-brand" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24"><path d={icons[i]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span>
            <span class="block text-[1.05rem] font-extrabold leading-snug text-ink">{p.title}</span>
            <span class="mt-1 block text-[0.95rem] leading-snug text-ink-soft">{p.text}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <div class="container-x pb-4 pt-12 md:pt-16">
    <div class="reveal relative isolate overflow-hidden rounded-[30px] bg-[#1c1b1a] p-6 text-white sm:p-10 md:p-14">
      <Pyramid size="clamp(12rem, 24vw, 20rem)" tone="night" opacity={0.08} class="pyramid-deco -bottom-10 right-8 -z-10" />
      <SectionHeading title="Planning a journey of your own?" lead="Tell us how you want India to feel, and we will plan the route around it." tone="dark" />
      <div class="mt-7 flex flex-wrap gap-2.5"><Button href="/plan" size="lg" track="plan_click">Plan your trip</Button><Button href="/how-booking-works" size="lg" variant="light">How booking works</Button></div>
    </div>
  </div>
</BaseLayout>
