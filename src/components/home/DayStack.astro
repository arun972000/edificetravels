---
/**
 * "One day in India": six moments as photo cards that stack as you scroll.
 * Each card pins below the header; the one underneath eases back and dims as
 * the next arrives, like turning postcards. The moment that matches the time
 * in India right now carries a live badge.
 */
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { photo } from '../../lib/photos';
import { getDict } from '../../i18n';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const slugs = ['agra-taj', 'jaipur-hawa-mahal', 'alleppey-houseboat', 'hero-rajasthan-desert', 'yoga-sunrise', 'udaipur-lake'];
const steps = t.home.daySteps.map((s, i) => ({ ...s, slug: slugs[i] }));
---

<section class="py-14 md:py-24" data-daystack>
  <div class="container-x">
    <SectionHeading title={t.home.dayTitle} lead={t.home.dayLead} />
  </div>
  <ol class="container-x mt-8 md:mt-12">
    {steps.map((s, i) => (
      <li class="stack-item follow-header sticky" style={`--i:${i}; top: calc(var(--sticky-top) + 0.75rem + ${i} * 0.5rem)`} data-stack-item data-time={s.time}>
        <article class="stack-card relative isolate mb-4 flex h-[min(72svh,40rem)] flex-col justify-end overflow-hidden rounded-[28px] bg-[#16181b] text-white md:mb-6 md:h-[min(78svh,44rem)] md:rounded-[36px]" data-stack-card>
          <Image src={photo(s.slug)} alt="" widths={[640, 960, 1280, 1800]} sizes="(min-width: 1312px) 77rem, 100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(10,11,13,0.85)_0%,rgba(10,11,13,0.3)_45%,transparent_72%)]" aria-hidden="true"></div>
          <div class="grid gap-4 p-5 sm:p-8 md:grid-cols-[auto_1fr] md:items-end md:gap-10 md:p-12">
            <p class="font-display text-[clamp(4rem,3rem+5vw,8.5rem)] leading-[0.82] tracking-[-0.04em] tabular-nums text-white">{s.time}</p>
            <div class="max-w-xl">
              <p class="flex flex-wrap items-center gap-2 text-[0.9rem] font-bold text-white/85">
                <span>{s.place}</span>
                <span class="day-now hidden items-center gap-1.5 rounded-pill bg-white px-2.5 py-1 text-[0.78rem] text-[#1b1d21]" data-day-now><span class="live-dot"></span>{t.home.dayNow}</span>
              </p>
              <h3 class="mt-2 font-display text-[clamp(1.75rem,1.4rem+1.4vw,2.6rem)] font-normal leading-[1.05] tracking-[-0.02em] text-white">{s.title}</h3>
              <p class="mt-3 text-[1rem] leading-relaxed text-white/82">{s.text}</p>
            </div>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .stack-card { transform-origin: 50% 0; transform: scale(var(--s, 1)); filter: brightness(var(--b, 1)); will-change: transform; }
  .day-now.is-on { display: inline-flex; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-daystack]').forEach(root => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-stack-item]'));
    const cards = items.map(i => i.querySelector<HTMLElement>('[data-stack-card]')!);

    // Ease each card back as the next one slides over it.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let raf = 0;
      const tick = () => {
        raf = 0;
        cards.forEach((card, k) => {
          const next = items[k + 1];
          if (!next) return;
          const cardTop = items[k].getBoundingClientRect().top;
          const nextTop = next.getBoundingClientRect().top;
          const h = card.offsetHeight;
          const p = Math.min(1, Math.max(0, 1 - (nextTop - cardTop) / h));
          card.style.setProperty('--s', (1 - p * 0.06).toFixed(4));
          card.style.setProperty('--b', (1 - p * 0.45).toFixed(3));
        });
      };
      window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
      tick();
    }

    // Mark the moment that matches the time in India right now.
    const ist = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date());
    const toMin = (hm: string) => { const [h, m] = hm.split(':').map(Number); return h * 60 + m; };
    const now = toMin(ist);
    const times = items.map(s => toMin(s.dataset.time ?? '00:00'));
    let live = times.length - 1;
    for (let k = 0; k < times.length; k++) if (now >= times[k]) live = k;
    if (now < times[0]) live = times.length - 1;
    items[live]?.querySelector('[data-day-now]')?.classList.add('is-on');
  });
</script>
