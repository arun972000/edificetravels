---
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Button from './Button.astro';
import Toran from './decor/Toran.astro';
import { site } from '../data/site';
import { waMessages } from '../lib/whatsapp';
import { getDict } from '../i18n';
import { localizedPath, type Locale } from '../i18n/config';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = getDict(locale);
const L = t.footer.links;
const lp = (p: string) => localizedPath(p, locale);
const year = new Date().getFullYear();
const columns = [
  { title: t.footer.colJourneys, items: [
    { label: L.allJourneys, href: '/journeys' },
    { label: L.rajasthan, href: '/regions/rajasthan' },
    { label: L.south, href: '/regions/south' },
    { label: L.north, href: '/regions/north' },
    { label: L.himalaya, href: '/regions/himalaya' },
    { label: L.east, href: '/regions/east-northeast' },
  ] },
  { title: t.footer.colCompany, items: [
    { label: L.story, href: lp('/about') },
    { label: L.specialists, href: `${lp('/about')}#specialists` },
    { label: L.booking, href: '/how-booking-works' },
    { label: L.responsible, href: '/responsible-travel' },
    { label: L.reviews, href: '/reviews' },
    { label: L.contact, href: lp('/contact') },
  ] },
  { title: t.footer.colHelp, items: [
    { label: L.plan, href: lp('/plan') },
    { label: L.visa, href: '/guide/india-e-visa-guide' },
    { label: L.cost, href: '/guide/what-a-private-india-trip-costs' },
    { label: L.bestTime, href: '/guide/best-time-to-visit-india' },
    { label: L.guide, href: '/guide' },
  ] },
  { title: t.footer.colLegal, items: [
    { label: L.privacy, href: '/privacy' },
    { label: L.cookies, href: '/cookies' },
    { label: L.terms, href: '/terms' },
    { label: L.bookingTerms, href: '/booking-terms' },
    { label: L.accessibility, href: '/accessibility' },
    { label: L.credits, href: '/credits' },
  ] },
];
---

<footer class="px-3 pb-3 pt-20 md:px-4 md:pb-4 md:pt-28">
  <div class="relative overflow-hidden rounded-[32px] bg-bg-muted text-ink-soft">
    <Toran class="absolute inset-x-0 top-0" />
    <div class:list={['container-x relative pb-10', site.decor ? 'pt-20 md:pt-24' : 'pt-12 md:pt-16']}>
      <div class="grid gap-10 lg:grid-cols-[1.25fr_2fr] lg:gap-16">
        <div class="max-w-md">
          <a href={lp('/')} class="press inline-flex text-ink" aria-label={`Edifice Travels, ${t.nav.home}`}><Logo size={52} /></a>
          <p class="mt-6 font-display text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)] leading-[1.08] text-ink">{t.footer.tagline}</p>
          <p class="mt-4 text-small">{t.footer.based}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <Button href={lp('/plan')} track="plan_click">{t.nav.plan}</Button>
            <WhatsAppButton href={waMessages.general()} trackLabel="footer" locale={locale} />
          </div>
          <div class="mt-6 space-y-1.5 text-small">
            <p><a class="font-semibold text-ink underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a></p>
            <p><a class="font-semibold text-ink underline-offset-4 hover:underline" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a> <span class="text-ink-muted">{t.footer.whatsappCalls}</span></p>
            <p class="text-ink-muted">{t.footer.hours}</p>
          </div>
        </div>

        <!-- Phones: each group folds open. -->
        <div class="divide-y divide-line border-y border-line lg:hidden">
          {columns.map(col => (
            <details class="foot-group group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[1rem] font-bold text-ink [&::-webkit-details-marker]:hidden">
                {col.title}
                <span class="grid h-8 w-8 place-items-center rounded-full bg-bg-elevated transition-transform duration-500 group-open:rotate-45" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <ul class="grid grid-cols-2 gap-x-4 gap-y-3 pb-5 text-small">
                {col.items.map(it => <li><a href={it.href} class="text-ink-soft hover:text-ink">{it.label}</a></li>)}
              </ul>
            </details>
          ))}
        </div>

        <!-- Larger screens: four columns. -->
        <div class="hidden grid-cols-4 gap-8 lg:grid">
          {columns.map(col => (
            <nav aria-label={col.title}>
              <h2 class="mb-4 font-sans text-[0.95rem] font-bold tracking-normal text-ink">{col.title}</h2>
              <ul class="space-y-2.5 text-small">
                {col.items.map(it => <li><a href={it.href} class="text-ink-soft underline-offset-4 transition-colors hover:text-ink hover:underline">{it.label}</a></li>)}
              </ul>
            </nav>
          ))}
        </div>
      </div>

      <div class="mt-12 flex flex-col gap-4 border-t border-line pt-6 text-[0.82rem] text-ink-muted md:flex-row md:items-center md:justify-between">
        <p>
          © {year} {site.name}, a unit of {site.legalName}. {site.address.street}, {site.address.locality} {site.address.postalCode}, India.
          {site.llpin && <span> LLPIN {site.llpin}.</span>}
          {site.gstin && <span> GSTIN {site.gstin}.</span>}
          {' '}{t.footer.quoted}
        </p>
        <div class="flex items-center gap-4">
          {site.social.instagram && <a href={site.social.instagram} rel="noopener" target="_blank" class="font-semibold hover:text-ink">Instagram</a>}
          {site.social.facebook && <a href={site.social.facebook} rel="noopener" target="_blank" class="font-semibold hover:text-ink">Facebook</a>}
          {site.social.youtube && <a href={site.social.youtube} rel="noopener" target="_blank" class="font-semibold hover:text-ink">YouTube</a>}
          {site.social.twitter && <a href={site.social.twitter} rel="noopener" target="_blank" class="font-semibold hover:text-ink">X</a>}
          <button type="button" id="theme-toggle" class="press inline-flex h-10 items-center gap-2 rounded-pill border border-line bg-bg-elevated px-3.5 font-semibold text-ink" aria-label={t.footer.theme} aria-pressed="false">
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.45-.07-.91-.1-1.36-.1Z"/></svg>
            <span>{t.footer.themeLabel}</span>
          </button>
        </div>
      </div>
    </div>
    <div class="foot-mark pointer-events-none select-none px-4 pb-2 text-center font-display text-[clamp(4.5rem,17vw,15rem)] leading-[0.8] text-ink/[0.05]" aria-hidden="true"></div>
  </div>
</footer>

<style>
  .foot-mark::before { content: "Edifice"; }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const currentTheme = () =>
    root.getAttribute('data-theme')
    ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  btn?.setAttribute('aria-pressed', String(currentTheme() === 'dark'));
  btn?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    btn.setAttribute('aria-pressed', String(next === 'dark'));
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
