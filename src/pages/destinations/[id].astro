---
/**
 * Destination page: a full guide to one place. In order:
 * overview (facts, the season at a glance, our notes, what not to miss),
 * the sights and how long each takes, what we arrange, where to stay (areas,
 * and the hotels our journeys use, read from the itineraries), what to eat,
 * the year season by season, getting there and around (with a map of the
 * neighbours), how we would spend the ideal stay, photographs, questions,
 * the journeys that pass through, and the places that pair well.
 * Sections without content are left out, and the section chips follow suit.
 */
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FactsBar from '../../components/FactsBar.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SectionTabs from '../../components/SectionTabs.astro';
import JourneyCard from '../../components/JourneyCard.astro';
import SpecialistCard from '../../components/SpecialistCard.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Button from '../../components/Button.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import MonthStrip from '../../components/MonthStrip.astro';
import Pyramid from '../../components/Pyramid.astro';
import Faq from '../../components/Faq.astro';
import Gallery from '../../components/Gallery.astro';
import RouteMap from '../../islands/RouteMap';
import { photo, hasPhoto } from '../../lib/photos';
import { photoAlt } from '../../data/photo-alt';
import { REGION_LABEL } from '../../lib/format';
import { waMessages } from '../../lib/whatsapp';
import { breadcrumbLd, destinationLd, faqLd } from '../../lib/seo';
import { journeysForDestination, allDestinations, specialistById, allRegions, allThemes, staysForDestination } from '../../lib/content';

export async function getStaticPaths() {
  const list = await getCollection('destinations');
  return list.map(d => ({ params: { id: d.id }, props: { destination: d } }));
}

const { destination } = Astro.props;
const d = destination.data;
const { Content } = await render(destination);
const journeys = await journeysForDestination(destination.id);
// Neighbours by real distance (great-circle km), whatever the region: Agra's
// are Delhi, Jaipur and Ranthambore, not only the other northern cities.
const km = (a: { lat: number; lng: number }, b: { lat: number; lng: number }) => {
  const r = Math.PI / 180;
  const h = Math.sin(((b.lat - a.lat) * r) / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(((b.lng - a.lng) * r) / 2) ** 2;
  return 12742 * Math.asin(Math.sqrt(h));
};
const neighbours = (await allDestinations())
  .filter(x => x.id !== destination.id)
  .map(x => ({ x, dist: km(d, x.data) }))
  .sort((a, b) => a.dist - b.dist);
const nearby = neighbours.slice(0, 4).map(n => n.x);
const mapPlaces = neighbours.filter((n, i) => i < 3 || n.dist < 450).slice(0, 7).map(n => n.x);
const region = (await allRegions()).find(r => r.id === d.region);
const specialist = await specialistById(region?.data.specialist ?? 'team');
const stays = await staysForDestination(destination);
const wa = waMessages.destination(d.title);
const og = await getImage({ src: photo(d.heroImage), width: 1200, format: 'jpeg' });
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Destinations', href: '/destinations' },
  { name: REGION_LABEL[d.region], href: `/regions/${d.region}` },
  { name: d.title, href: `/destinations/${destination.id}` },
];
const ld = [
  destinationLd({ id: destination.id, title: d.title, description: d.seo.description, image: og.src, lat: d.lat, lng: d.lng, state: d.state, highlights: d.highlights, sights: d.sights }),
  breadcrumbLd(crumbs),
  ...(d.faqs.length ? [faqLd(d.faqs)] : []),
];
// Rajasthan is both the state and the region: say it once.
const sameAsState = REGION_LABEL[d.region] === d.state;
// Theme hubs that list this place.
const hubs = (await allThemes()).filter(h => h.data.destinations.includes(destination.id));
const firstRoad = d.gettingThere?.road[0];
const facts = [
  { label: 'State', value: d.state },
  { label: 'Ideal stay', value: d.idealNights },
  ...(sameAsState ? [] : [{ label: 'Region', value: REGION_LABEL[d.region] }]),
  ...(firstRoad ? [{ label: `From ${firstRoad.from}`, value: firstRoad.time }] : []),
];
const gallery = d.gallery.filter(g => hasPhoto(g) && g !== d.heroImage);
const mapStops = [destination, ...mapPlaces].map(x => ({ name: x.data.title, lat: x.data.lat, lng: x.data.lng, href: `/destinations/${x.id}` }));
const hasStay = !!d.stay || stays.length > 0;
const hasGetting = !!d.gettingThere && (d.gettingThere.air || d.gettingThere.rail || d.gettingThere.road.length || d.gettingThere.around);
const tabs = [
  { id: 'overview', label: 'Overview' },
  ...(d.sights.length ? [{ id: 'sights', label: 'Sights' }] : []),
  { id: 'arrange', label: 'What we arrange' },
  ...(hasStay ? [{ id: 'stay', label: 'Where to stay' }] : []),
  ...(d.food.length ? [{ id: 'food', label: 'Food' }] : []),
  { id: 'when', label: 'When to go' },
  ...(hasGetting ? [{ id: 'getting-there', label: 'Getting there' }] : []),
  ...(d.plan.length ? [{ id: 'days', label: 'Day by day' }] : []),
  ...(d.faqs.length ? [{ id: 'questions', label: 'Questions' }] : []),
];
const styles = [
  { key: 'comfort', name: 'Comfort' },
  { key: 'premium', name: 'Premium' },
  { key: 'luxury', name: 'Luxury' },
] as const;
const pin = 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z';
---

<BaseLayout title={d.seo.title ?? `${d.title}: when to go, how long to stay`} description={d.seo.description} jsonLd={ld} image={og.src} imageAlt={photoAlt(d.heroImage, d.title)} progress>
  <Hero image={photo(d.heroImage)} alt={photoAlt(d.heroImage, d.title)} eyebrow={sameAsState ? `${d.state}, India` : `${d.state}, ${REGION_LABEL[d.region]}`} title={d.title} lead={d.tagline} breadcrumbs={crumbs} height="tall" primary={{ href: '/plan', label: `Include ${d.title} in my trip`, track: 'plan_click' }} whatsapp={wa} />

  <SectionTabs class="mt-4" items={tabs} />

  <!-- Overview -->
  <section id="overview" class="container-x pt-6 md:pt-10">
    <FactsBar facts={facts} />
    <div class="mt-4 grid gap-4 rounded-[22px] bg-bg-muted p-4 sm:p-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-center lg:gap-8">
      <MonthStrip months={d.bestMonths} />
      {hubs.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 lg:justify-end">
          <span class="kicker mr-1">Good for</span>
          {hubs.map(h => <a href={`/themes/${h.id}`} class="chip !h-9 !px-3.5 !text-[0.85rem]">{h.data.title}</a>)}
        </div>
      )}
    </div>
  </section>

  <section class="container-x grid grid-cols-1 gap-10 pt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,23rem)] lg:gap-16 md:pt-12">
    <div class="min-w-0">
      <div class="prose-editorial"><Content /></div>
      <h2 class="mt-12 text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)] text-ink">Do not miss</h2>
      <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
        {d.highlights.map(h => (
          <li class="reveal flex items-start gap-3 rounded-[20px] bg-bg-muted p-4 text-[1rem] leading-snug text-ink"><span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand text-[#1c1b1a]" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 6.5l2.2 2.2L9.5 3.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="font-semibold">{h}</span></li>
        ))}
      </ul>
    </div>
    <aside class="space-y-3 follow-header lg:sticky lg:top-[calc(var(--sticky-top)+5rem)] lg:self-start">
      <SpecialistCard specialist={specialist} whatsapp={wa} context={`Ask us about ${d.title}`} compact />
      <div class="reveal relative isolate overflow-hidden rounded-[24px] bg-[#1c1b1a] p-6 text-white">
        <Pyramid size="9rem" tone="night" opacity={0.09} class="pyramid-deco -bottom-4 -right-4 -z-10" />
        <p class="font-display text-[1.5rem] leading-tight text-white">{d.title} in your journey</p>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-white/80">Tell us where else you want to go. We work out the order, the drives and how many nights each place needs, and send an itemised quote within 48 hours.</p>
        <div class="mt-5"><Button href="/plan" size="lg" track="plan_click" class="w-full">Plan your trip</Button></div>
      </div>
    </aside>
  </section>

  <!-- Sights -->
  {d.sights.length > 0 && (
    <section id="sights" class="container-x pt-12 md:pt-16">
      <SectionHeading eyebrow={`${d.sights.length} sights`} title={`What to see in ${d.title}`} lead="In the order we would put them, with roughly how long each one deserves." />
      <ol class="mt-7 grid gap-3 md:grid-cols-2">
        {d.sights.map((s, i) => (
          <li class="reveal flex gap-4 rounded-[22px] border border-line bg-bg-elevated p-5 sm:p-6">
            <span class="font-display text-[2.2rem] leading-none text-brand-deep" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="min-w-0">
              <h3 class="text-[1.15rem] font-extrabold leading-snug text-ink">{s.name}</h3>
              {s.time && <p class="mt-1.5 inline-flex rounded-pill bg-brand-soft px-2.5 py-1 text-[0.78rem] font-bold text-brand-deep">{s.time}</p>}
              <p class="mt-2 text-[0.97rem] leading-relaxed text-ink-soft">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- What we arrange -->
  <section id="arrange" class="pt-12 md:pt-16">
    <div class="container-x">
      <div class="relative isolate overflow-hidden rounded-[32px] bg-brand px-5 py-10 text-[#1c1b1a] sm:px-8 md:px-12 md:py-14">
        <Pyramid size="clamp(12rem, 26vw, 22rem)" tone="ink" opacity={0.12} class="pyramid-deco -bottom-10 -right-6 -z-10" />
        <SectionHeading title={`${d.title}, the way we arrange it`} tone="brand" />
        <div class="mt-8 grid gap-3 md:grid-cols-2">
          {d.experiences.map(e => (
            <div class="reveal rounded-[22px] bg-[#1c1b1a] p-5 sm:p-6">
              <h3 class="text-h3 !text-white">{e.title}</h3>
              <p class="mt-2 text-body text-white/80">{e.text}</p>
            </div>
          ))}
        </div>
        {d.tips.length > 0 && (
          <div class="reveal mt-3 rounded-[22px] bg-bg-elevated p-5 text-ink sm:p-6">
            <h3 class="flex items-center gap-2 text-[1rem] font-extrabold text-ink"><Pyramid size={18} />Good to know</h3>
            <ul class="mt-3 space-y-2.5 text-[0.95rem] text-ink-soft">
              {d.tips.map(t => <li class="flex gap-2.5"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span><span>{t}</span></li>)}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Where to stay -->
  {hasStay && (
    <section id="stay" class="container-x pt-12 md:pt-16">
      <SectionHeading title={`Where to stay in ${d.title}`} lead={d.stay?.intro} />
      {d.stay && d.stay.areas.length > 0 && (
        <ul class="mt-7 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          {d.stay.areas.map(a => (
            <li class="reveal rounded-[22px] bg-bg-muted p-5 sm:p-6">
              <h3 class="flex items-center gap-2 text-[1.05rem] font-extrabold text-ink"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="text-brand-deep"><path d={pin} fill="none" stroke="currentColor" stroke-width="1.9" /></svg>{a.name}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{a.text}</p>
            </li>
          ))}
        </ul>
      )}
      {stays.length > 0 && (
        <div class="reveal mt-4 overflow-hidden rounded-[24px] border border-line">
          <p class="bg-[#1c1b1a] px-5 py-3.5 text-[0.95rem] font-extrabold text-white">Where our journeys stay, by style <span class="font-semibold text-white/70">(confirmed in your quote)</span></p>
          <div class="divide-y divide-line">
            {stays.map(row => (
              <div class="grid gap-3 p-5 md:grid-cols-[9rem_1fr_1fr_1fr] md:gap-5">
                <p class="text-[0.95rem] font-extrabold text-ink">{row.location}</p>
                {styles.map(s => (
                  <div class="min-w-0">
                    <p class="text-[0.78rem] font-extrabold text-brand-deep">{s.name}</p>
                    <ul class="mt-1 space-y-0.5 text-[0.93rem] text-ink">{row[s.key].map(h => <li>{h}</li>)}</ul>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  <!-- Food -->
  {d.food.length > 0 && (
    <section id="food" class="container-x pt-12 md:pt-16">
      <div class="relative isolate overflow-hidden rounded-[32px] bg-[#1c1b1a] px-5 py-10 text-white sm:px-8 md:px-12 md:py-14">
        <Pyramid size="clamp(12rem, 26vw, 22rem)" tone="night" opacity={0.07} class="pyramid-deco -bottom-10 -right-6 -z-10" />
        <SectionHeading title={`What to eat in ${d.title}`} tone="dark" />
        <ul class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          {d.food.map(f => (
            <li class="reveal rounded-[22px] bg-white/[0.06] p-5 ring-1 ring-white/10">
              <h3 class="flex items-center gap-2.5 text-[1.08rem] font-extrabold !text-white"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand text-[#1c1b1a]" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24"><path d="M7 3v8a2 2 0 0 0 2 2v8M5 3v5M9 3v5M17 3c-1.7 0-3 2.2-3 5s1.3 4 3 4v9" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>{f.name}</h3>
              <p class="mt-2.5 text-[0.95rem] leading-relaxed text-white/80">{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- When to go -->
  <section id="when" class="container-x pt-12 md:pt-16">
    <div class="grid gap-8 rounded-[32px] bg-bg-muted px-5 py-10 sm:px-8 md:px-12 md:py-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12">
      <div class="self-start">
        <SectionHeading title={`When to go to ${d.title}`} />
        <MonthStrip months={d.bestMonths} class="mt-7" />
      </div>
      {d.seasons.length > 0 ? (
        <dl class="grid gap-2.5">
          {d.seasons.map(s => (
            <div class="reveal grid gap-1 rounded-[18px] border-l-4 border-brand bg-bg-elevated px-4 py-3.5 sm:grid-cols-[9.5rem_1fr] sm:gap-4">
              <dt class="text-[0.98rem] font-extrabold text-brand-deep">{s.months}</dt>
              <dd class="text-[0.95rem] leading-relaxed text-ink-soft">{s.text}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="text-[1rem] text-ink-soft">The best months are marked in orange. <a href="/guide/best-time-to-visit-india" class="font-bold text-brand-deep underline underline-offset-4">The best time to visit India, region by region</a></p>
      )}
    </div>
  </section>

  <!-- Getting there and around -->
  {hasGetting && (
    <section id="getting-there" class="container-x pt-12 md:pt-16">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
        <div>
          <SectionHeading title="Getting there and around" lead="Times are typical, and depend on traffic, fog in winter and the day of the week." />
          <div class="mt-7 space-y-3">
            {d.gettingThere?.air && (
              <div class="reveal flex gap-4 rounded-[20px] border border-line p-4 sm:p-5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand text-[#1c1b1a]" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M10.5 13.5 3 11l1.5-1.5 7.5 1L16 6.5a2.1 2.1 0 0 1 3 3L15 13.5l1 7.5-1.5 1.5L12 15l-3 3v2.5L7.5 22 6 18l-4-1.5L3.5 15H6l3-3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg></span>
                <div><p class="text-[0.85rem] font-extrabold text-brand-deep">By air</p><div class="mt-0.5 text-[0.97rem] leading-relaxed text-ink">{d.gettingThere.air}</div></div>
              </div>
            )}
            {d.gettingThere?.rail && (
              <div class="reveal flex gap-4 rounded-[20px] border border-line p-4 sm:p-5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#1c1b1a] text-brand" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M7 3h10a2 2 0 0 1 2 2v9a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V5a2 2 0 0 1 2-2Zm-2 7h14M8 21l2-4M16 21l-2-4M8.5 13.5h.01M15.5 13.5h.01" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <div><p class="text-[0.85rem] font-extrabold text-brand-deep">By train</p><div class="mt-0.5 text-[0.97rem] leading-relaxed text-ink">{d.gettingThere.rail}</div></div>
              </div>
            )}
            {d.gettingThere && d.gettingThere.road.length > 0 && (
              <div class="reveal flex gap-4 rounded-[20px] border border-line p-4 sm:p-5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-soft text-brand-deep" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M5 17h14l-1.4-6.3A2 2 0 0 0 15.7 9H8.3a2 2 0 0 0-1.9 1.7ZM7 17v2M17 17v2M7.5 13.5h.01M16.5 13.5h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <div class="min-w-0 flex-1">
                  <p class="text-[0.85rem] font-extrabold text-brand-deep">By road, with your driver</p>
                  <div class="mt-1.5">
                    <ul class="divide-y divide-line">
                      {d.gettingThere.road.map(r => <li class="flex items-baseline justify-between gap-4 py-1.5 text-[0.95rem]"><span class="shrink-0 text-ink-soft">From {r.from}</span><span class="min-w-0 text-right font-bold text-ink">{r.time}</span></li>)}
                    </ul>
                  </div>
                </div>
              </div>
            )}
            {d.gettingThere?.around && (
              <div class="reveal rounded-[20px] bg-bg-muted p-4 sm:p-5">
                <p class="text-[0.85rem] font-extrabold text-brand-deep">Getting around</p>
                <div class="mt-0.5 text-[0.97rem] leading-relaxed text-ink-soft">{d.gettingThere.around}</div>
              </div>
            )}
          </div>
        </div>
        {mapStops.length >= 2 && (
          <div class="reveal lg:pt-4">
            <RouteMap client:visible stops={mapStops} mode="constellation" title={`${d.title} and its neighbours`} />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- How we'd spend the days -->
  {d.plan.length > 0 && (
    <section id="days" class="container-x pt-12 md:pt-16">
      <SectionHeading title={`${d.title}, day by day`} lead={`How we would spend ${d.idealNights.toLowerCase()} here. Every day can change around you.`} />
      <ol class="relative mt-8">
        <span class="absolute bottom-6 left-[1.1rem] top-2 w-1 rounded-full bg-brand-tint md:left-[1.35rem]" aria-hidden="true"></span>
        {d.plan.map((p, i) => (
          <li class="relative pb-4 pl-12 md:pl-16">
            <span class="absolute left-0 top-0 grid h-9 w-9 place-items-center rounded-full bg-brand text-[0.85rem] font-extrabold text-[#1c1b1a] ring-4 ring-bg md:h-11 md:w-11 md:text-[0.95rem]" aria-hidden="true">{i + 1}</span>
            <article class="reveal rounded-[22px] bg-bg-muted p-5 sm:p-6">
              <p class="text-[0.85rem] font-extrabold text-brand-deep">Day {i + 1}</p>
              <h3 class="mt-1 font-display text-[clamp(1.35rem,1.2rem+0.6vw,1.75rem)] font-normal leading-[1.12] tracking-[-0.015em] text-ink">{p.title}</h3>
              <p class="mt-2.5 max-w-3xl text-[0.97rem] leading-relaxed text-ink-soft">{p.text}</p>
            </article>
          </li>
        ))}
      </ol>
    </section>
  )}

  {gallery.length > 0 && (
    <section class="container-x pt-10 md:pt-14">
      <Gallery slugs={gallery} />
    </section>
  )}

  {d.faqs.length > 0 && (
    <section id="questions" class="container-x pt-12 md:pt-16">
      <SectionHeading title={`Questions about ${d.title}`} />
      <div class="mt-7"><Faq faqs={d.faqs} /></div>
    </section>
  )}

  {journeys.length > 0 && (
    <section class="container-x pt-12 md:pt-16">
      <SectionHeading title={`Journeys that pass through ${d.title}`} />
      <div class="mt-7 grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {journeys.map(j => <JourneyCard journey={j} />)}
      </div>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="container-x pt-12 md:pt-16">
      <SectionHeading title={`Places that pair well with ${d.title}`} />
      <div class="mt-7 grid grid-cols-2 gap-x-3 gap-y-8 lg:grid-cols-4 lg:gap-x-5">
        {nearby.map(x => <DestinationCard destination={x} />)}
      </div>
    </section>
  )}

  <section class="container-x pb-4 pt-12 md:pt-16">
    <div class="reveal relative isolate grid gap-6 overflow-hidden rounded-[30px] bg-[#1c1b1a] p-6 text-white sm:p-10 md:grid-cols-[1fr_auto] md:items-center md:p-14">
      <Pyramid size="clamp(12rem, 24vw, 20rem)" tone="night" opacity={0.08} class="pyramid-deco -bottom-10 right-10 -z-10" />
      <SectionHeading title={`Put ${d.title} in your journey`} lead="Tell us where else you want to go. We work out the order, the drives and how many nights each place needs." tone="dark" />
      <div class="flex flex-col gap-2.5 sm:flex-row md:flex-col">
        <Button href="/plan" size="lg" track="plan_click">Plan your trip</Button>
        <WhatsAppButton href={wa} size="lg" variant="inverse" label="WhatsApp a specialist" trackLabel="destination-bottom" />
      </div>
    </div>
  </section>
</BaseLayout>
