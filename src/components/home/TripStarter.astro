---
/**
 * Straight after the hero: the first choices as chips (phones only; wide
 * screens see them on the hero), then three promises as cards that sit side
 * by side on wide screens and swipe on phones.
 */
import type { CollectionEntry } from 'astro:content';
import { getDict, regionCopy } from '../../i18n';
import { localizedPath, type Locale } from '../../i18n/config';

interface Props { locale: Locale; regions: CollectionEntry<'regions'>[] }
const { locale, regions } = Astro.props;
const t = getDict(locale);
const icons = [
  'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12ZM8.5 11h.01M12 11h.01M15.5 11h.01',
  'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Zm0 0v5h5M9 13h6M9 17h4',
  'M5 17h14l-1.4-6.3A2 2 0 0 0 15.7 9H8.3a2 2 0 0 0-1.9 1.7ZM7 17v2M17 17v2M7.5 13.5h.01M16.5 13.5h.01',
];
---

<section class="relative z-10 pb-6 pt-8 lg:pt-14">
  <div class="lg:hidden">
    <p class="container-x reveal text-[1.05rem] font-bold text-ink">{t.home.startTitle}</p>
    <div class="no-scrollbar mt-3 flex gap-2 overflow-x-auto px-4 sm:px-6">
      {regions.map((r, i) => (
        <a href={`/regions/${r.id}`} class="chip reveal shrink-0" style={`--delay:${i * 60}ms`}>{regionCopy(r.id, locale, { title: r.data.title, tagline: r.data.tagline }).title}</a>
      ))}
      <a href={localizedPath('/plan', locale)} class="chip reveal shrink-0 !border-brand !bg-brand-soft" style={`--delay:${regions.length * 60}ms`}>{t.home.designOwn}</a>
    </div>
  </div>

  <ul class="swipe mt-8 lg:mt-0 lg:!grid lg:!grid-flow-row lg:!grid-cols-3 lg:!overflow-visible" role="list" tabindex="0" aria-label={t.home.promises.map(p => p.title).join(", ")}>
    {t.home.promises.map((p, i) => (
      <li class="reveal flex items-start gap-4 rounded-[24px] bg-bg-muted p-5" style={`--delay:${i * 90}ms`}>
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-bg-elevated text-brand-deep shadow-1" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24"><path d={icons[i]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <span>
          <span class="block text-[1.02rem] font-extrabold leading-snug text-ink">{p.title}</span>
          <span class="mt-0.5 block text-[0.92rem] leading-snug text-ink-soft">{p.text}</span>
        </span>
      </li>
    ))}
  </ul>
</section>
