---
/**
 * Page hero for journeys, regions, destinations and other pages: the
 * photograph as a large rounded postcard, the title set over it. The photo
 * settles from a light zoom and the headline rises word by word, all within
 * about a second. The card grows with its text, so long translated titles are
 * never cut off. `vtName` lets a card
 * image morph into this hero during a page transition.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getDict } from '../i18n';
import type { Locale } from '../i18n/config';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  emphasis?: string;
  lead?: string;
  primary?: { href: string; label: string; track?: string };
  secondary?: { href: string; label: string };
  whatsapp?: string;
  height?: 'full' | 'tall' | 'medium';
  align?: 'left' | 'center';
  breadcrumbs?: { name: string; href: string }[];
  titleAs?: 'h1' | 'p';
  vtName?: string;
  locale?: Locale;
}
const {
  image, alt, eyebrow, title, lead, primary, secondary, whatsapp,
  height = 'tall', breadcrumbs, titleAs: TitleTag = 'h1', vtName, locale = 'en',
} = Astro.props;
const t = getDict(locale);
const heights = { full: 'min-h-[calc(100svh-var(--header-h)-1rem)]', tall: 'min-h-[66svh] md:min-h-[72svh]', medium: 'min-h-[50svh] md:min-h-[56svh]' };
const words = title.split(/\s+/);
---

<section class="px-3 pt-1 md:px-4" data-hero>
  <div class:list={['hero-card relative isolate flex flex-col justify-end overflow-hidden rounded-[28px] bg-[#16181b] text-white md:rounded-[36px]', heights[height]]}>
    <div class="hero-media absolute inset-0 -z-10" data-hero-media>
      <Image
        src={image}
        alt={alt}
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="calc(100vw - 2rem)"
        quality={66}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-img h-full w-full object-cover"
        style={vtName ? `view-transition-name: ${vtName}` : undefined}
      />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(10,11,13,0.82)_0%,rgba(10,11,13,0.35)_45%,rgba(10,11,13,0.05)_75%)]" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-black/35 to-transparent" aria-hidden="true"></div>

    <div class="relative p-5 pb-6 sm:p-8 md:p-12 lg:p-14">
      {breadcrumbs && <div class="ph-in mb-5" style="--d:.05s"><Breadcrumbs items={breadcrumbs} light /></div>}
      {eyebrow && <p class="ph-in mb-4 inline-flex rounded-pill bg-brand px-3.5 py-1.5 text-[0.85rem] font-extrabold text-on-brand shadow-[var(--shadow-brand)]" style="--d:.12s">{eyebrow}</p>}
      <TitleTag class="max-w-4xl text-[clamp(2.4rem,1.6rem+3.8vw,5.5rem)] leading-[0.98] tracking-[-0.025em] text-white">
        {words.map((w, i) => (
          <><span class="w"><span class="ph-word" style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 ? ' ' : ''}</>
        ))}
      </TitleTag>
      {lead && <p class="ph-in mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-white/88 md:mt-5 md:text-lead" style="--d:.22s">{lead}</p>}
      {(primary || whatsapp || secondary) && (
        <div class="ph-in mt-6 flex flex-wrap items-center gap-2.5 md:mt-8" style="--d:.3s">
          {primary && <Button href={primary.href} size="lg" track={primary.track}>{primary.label}</Button>}
          {secondary && <Button href={secondary.href} size="lg" variant="light">{secondary.label}</Button>}
          {whatsapp && <WhatsAppButton href={whatsapp} size="lg" variant="inverse" label={t.common.whatsappSpecialist} trackLabel="hero" locale={locale} />}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-img { animation: hero-settle 1.2s var(--ease-out) both; }
  .ph-word { transform: translateY(110%); animation: ph-up 0.65s var(--ease-out) forwards; animation-delay: calc(0.05s + min(var(--i), 10) * 0.035s); }
  .ph-in { opacity: 0; transform: translateY(10px); animation: ph-fade 0.55s var(--ease-out) forwards; animation-delay: var(--d); }
  @keyframes hero-settle { from { transform: scale(1.05); } to { transform: none; } }
  @keyframes ph-up { to { transform: none; } }
  @keyframes ph-fade { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-img, .ph-word, .ph-in { animation: none; opacity: 1; transform: none; }
  }
</style>

