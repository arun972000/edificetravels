---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import GuestAvatar from './GuestAvatar.astro';

interface Props {
  reviews: CollectionEntry<'reviews'>[];
  locale?: string;
  title?: string;
  lead?: string;
  as?: 'h1' | 'h2';
  showAll?: boolean;
}

const { reviews, title = 'In their own words', lead, as = 'h2', showAll = true } = Astro.props;
const visibleReviews = showAll ? reviews.slice(0, 3) : reviews;
const reviewCount = reviews.length;
const star = '<path d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.7L10 14.8l-5.1 2.7 1-5.7-4.1-4 5.7-.8z"/>';
---

{visibleReviews.length > 0 && (
  <section class="reviews-section py-14 md:py-20">
    <div class="container-x">
      <SectionHeading title={title} lead={lead} as={as} size={as === 'h1' ? 'h1' : 'h2'}>
        {showAll && <a slot="action" href="/reviews" class="chip">All guest stories</a>}
      </SectionHeading>

      <div class="review-proof-row">
        <p class="review-proof">
          <strong>{reviewCount}</strong> reviews and many happy customers
        </p>
        <a href="/reviews#share-your-moment" class="review-share-link">Share your moment with us</a>
      </div>

      <ul class="review-grid mt-8 md:mt-10" role="list">
        {visibleReviews.map((review, index) => {
          const item = review.data;
          return (
            <li class="review-card">
              <figure>
                <div class="review-rating" role="img" aria-label={`${item.rating} out of 5 stars`}>
                  {Array.from({ length: 5 }, (_, starIndex) => (
                    <svg class:list={['review-star', starIndex < item.rating && 'is-filled']} viewBox="0 0 20 20" aria-hidden="true" set:html={star}></svg>
                  ))}
                  <span class="review-source">Guest review</span>
                </div>
                <blockquote class="review-quote">“{item.quote}”</blockquote>
                <figcaption class="review-guest">
                  <GuestAvatar name={item.name} size={42} tone={index} />
                  <span class="review-identity">
                    <span class="review-name">{item.name}</span>
                    {item.trip && <span class="review-trip">{item.trip}</span>}
                  </span>
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>

    </div>
  </section>
)}

<style>
  .review-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin-bottom: 0;
  }
  @media (min-width: 42rem) {
    .review-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.15rem; }
  }
  @media (min-width: 68rem) {
    .review-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  }
  .review-card {
    min-width: 0;
    padding: 1.35rem;
    border: 1px solid var(--c-line);
    border-radius: 12px;
    background: var(--c-bg-elevated);
  }
  @media (min-width: 48rem) {
    .review-card { padding: 1.55rem; }
  }
  .review-card figure { display: flex; min-height: 100%; flex-direction: column; }
  .review-proof-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1rem; margin-top: 0.6rem; }
  .review-proof { margin: 0; color: var(--c-ink-muted); font-size: 0.88rem; }
  .review-proof strong { color: var(--c-ink); font-size: 1rem; }
  .review-share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: var(--c-brand-soft);
    color: var(--c-brand-deep);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 150ms ease, transform 150ms ease;
  }
  .review-share-link:hover { background: var(--c-brand-tint); }
  .review-share-link:focus-visible { outline: 2px solid var(--c-brand); outline-offset: 3px; }
  .review-rating { display: flex; align-items: center; gap: 0.18rem; color: var(--c-brand); }
  .review-star { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.1; }
  .review-star.is-filled { fill: currentColor; }
  .review-source { margin-left: auto; color: var(--c-ink-muted); font-size: 0.75rem; font-weight: 650; }
  .review-quote {
    margin: 1.15rem 0 1.5rem;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.48;
    overflow-wrap: anywhere;
  }
  .review-guest { display: flex; align-items: center; gap: 0.7rem; margin-top: auto; }
  .review-identity { display: grid; min-width: 0; gap: 0.12rem; }
  .review-name { overflow: hidden; color: var(--c-ink); font-size: 0.9rem; font-weight: 750; text-overflow: ellipsis; }
  .review-trip { color: var(--c-ink-muted); font-size: 0.8rem; }
</style>
