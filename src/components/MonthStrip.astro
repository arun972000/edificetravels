---
/**
 * Twelve months in a row, the good ones filled in the logo orange. Reads at a
 * glance where "Oct to Mar" needs a second look, and works for any list of
 * month codes (journeys, destinations, theme hubs). The text summary is the
 * accessible name; the cells are decoration on top of it.
 */
import { formatMonths } from '../lib/format';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

interface Props {
  months: readonly string[];
  label?: string;
  /** 'night' for black panels. */
  tone?: 'light' | 'night';
  class?: string;
}
const { months, label = 'Best months', tone = 'light', class: className = '' } = Astro.props;
const on = new Set(months);
const summary = formatMonths(months);
---

<div class:list={['month-strip', className]}>
  <p class:list={['flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-[0.9rem]', tone === 'night' ? 'text-white/75' : 'text-ink-soft']}>
    <span class:list={['font-extrabold', tone === 'night' ? 'text-brand' : 'text-brand-deep']}>{label}</span>
    <span class:list={['font-bold', tone === 'night' ? 'text-white' : 'text-ink']}>{summary}</span>
  </p>
  <ol class="mt-3 grid grid-cols-6 gap-1.5 sm:grid-cols-12" aria-label={`${label}: ${summary}`}>
    {MONTHS.map(m => (
      <li
        class:list={[
          'grid h-12 place-items-center rounded-[12px] text-[0.82rem] font-extrabold',
          on.has(m)
            ? 'bg-brand text-[#1c1b1a]'
            : tone === 'night' ? 'bg-white/8 text-white/45' : 'bg-bg-muted text-ink-muted',
        ]}
        aria-hidden="true"
      >{m}</li>
    ))}
  </ol>
</div>
