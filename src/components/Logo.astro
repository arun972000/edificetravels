---
import { Image } from 'astro:assets';
import logo from '../assets/brand/edifice-travels-full-logo.png';

interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 128 } = Astro.props;
const height = Math.round(size * 747 / 1600);
---

<span class:list={['brand-logo inline-flex max-w-full items-center rounded-md', className]} style={`width:min(${size}px, 40vw)`}>
  <Image src={logo} alt="" width={size} height={height} densities={[1, 2]} loading="eager" class="block h-auto w-full" />
</span>

<style>
  .brand-logo { flex: 0 1 auto; }
  :global(:root[data-theme="dark"]) .brand-logo { background: #fff; padding: 2px 6px; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .brand-logo { background: #fff; padding: 2px 6px; }
  }
</style>
