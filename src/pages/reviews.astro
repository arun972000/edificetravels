---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Testimonials from '../components/Testimonials.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import { allReviews } from '../lib/content';
import { breadcrumbLd } from '../lib/seo';

const reviews = await allReviews();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guest stories', href: '/reviews' }];
---

<BaseLayout title="Guest stories and testimonials" description="What travellers told us after their journeys with Edifice Travels, quoted exactly as they wrote them, with room to share your own story." jsonLd={[breadcrumbLd(crumbs)]}>
  <div class="container-x pt-8 md:pt-14">
    <Breadcrumbs items={crumbs} />
  </div>
  <Testimonials reviews={reviews} as="h1" title="Guest stories" lead="What travellers told us once they were home, quoted exactly as they wrote it." showAll={false} />
  <div id="share-your-moment" class="container-x pb-14 md:pb-20">
    <div class="reveal rounded-[30px] bg-night p-6 text-white sm:p-10 md:p-14">
      <SectionHeading title="Share your moment with us" lead="We would love to hear about the memories, the people, and the little details that made your journey unforgettable." dark />
      <div class="mt-7"><Button href="/plan" size="lg" track="share_review_click">Share your moment with us</Button></div>
    </div>
  </div>
</BaseLayout>
