---
/**
 * The Edifice Travels badge, made from the original artwork with its light
 * background removed (src/assets/brand). In dark mode it sits on a white disc
 * so the black ring and lettering stay visible. The wordmark beside it keeps
 * the name readable at header size, where the badge lettering is tiny.
 */
import { Image } from 'astro:assets';
import badge from '../assets/brand/edifice-travels-logo.png';

interface Props {
  class?: string;
  compact?: boolean;
  /** Badge size in CSS pixels. The artwork is 180 px, so keep this at 60 or less. */
  size?: number;
}
const { class: className = '', compact = false, size = 44 } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <span class="logo-badge" style={`width:${size}px;height:${size}px`}>
    <Image src={badge} alt="" width={size} height={size} densities={[1, 2, 3]} loading="eager" class="block h-full w-full" />
  </span>
  {!compact && (
    <span class="flex flex-col leading-none">
      <span class="font-display text-[1.05rem] tracking-[-0.05em] text-brand-deep">Edifice</span>
      <span class="mt-0.5 font-sans text-[0.62rem] font-bold uppercase tracking-[0.22em] text-ink-soft">Travels</span>
    </span>
  )}
</span>

<style>
  .logo-badge { display: block; flex-shrink: 0; border-radius: 9999px; }
  :global(:root[data-theme="dark"]) .logo-badge { background: #fff; box-shadow: 0 0 0 1.5px #fff; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo-badge { background: #fff; box-shadow: 0 0 0 1.5px #fff; }
  }
</style>
